<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="aypatech_ai_assistant.ai_Chat" t-inherit-mode="extension">
        <xpath expr="//ChatComposer" position="attributes">
            <attribute name="onInvokeSkill.bind">runSkill</attribute>
        </xpath>
    </t>

    <t t-inherit="aypatech_ai_assistant.ai_ChatWindow" t-inherit-mode="extension">
        <xpath expr="//ChatComposer" position="attributes">
            <attribute name="onInvokeSkill.bind">runSkill</attribute>
        </xpath>
    </t>

    <t t-inherit="aypatech_ai_assistant.ai_ChatComposer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('ayp_composer_host')]" position="attributes">
            <attribute name="t-ref">this.hostRef</attribute>
        </xpath>
        <xpath expr="//div[hasclass('ayp_composer')]" position="before">
            <SkillsPanel
                t-if="this.showSkillsPanel"
                skills="this.availableSkills"
                lockedSkills="this.lockedSkills"
                autofocus="this.skillsAutofocus"
                onSelect.bind="this.invokeSkill"
                onClose.bind="this.closeSkillsPanel"
            />
        </xpath>
        <xpath expr="//textarea" position="before">
            <button
                type="button"
                class="btn ayp_skill_btn rounded-circle"
                t-if="this.hasSkills"
                t-att-class="{ active: this.localState.skillsOpen }"
                t-on-mousedown.prevent="() => {}"
                t-on-click="() => this.toggleSkillsPanel()"
                title="Skills"
            >
                <i class="fa fa-bolt"/>
            </button>
        </xpath>
    </t>

</templates>
