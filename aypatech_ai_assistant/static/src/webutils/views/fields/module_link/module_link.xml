<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.webutils_ModuleLinkField">
        <CheckBox
            t-if="this.state.available"
            id="this.props.id"
            value="this.state.value"
            className="'d-inline-block'"
            disabled="this.props.readonly"
            onChange.bind="this.onChange"
        />
        <a
            t-else=""
            t-att-href="this.appstoreLink"
            target="_blank"
            rel="noopener"
            class="o_module_link text-decoration-none"
            title="Get this add-on from the Odoo Apps store"
        >
            <i class="fa fa-cloud-download fa-lg"/>
        </a>
    </t>

</templates>
