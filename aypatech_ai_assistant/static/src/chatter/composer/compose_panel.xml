<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.chatter_ComposePanel">
        <div class="o-mail-ComposePanel d-flex flex-column">

            <div class="o-mail-ComposePanel-head d-flex align-items-center gap-2 px-3 py-2">
                <span class="ayp_icon_ai o-mail-ComposePanel-markIcon"/>
                <div class="d-flex flex-column lh-sm me-auto o-min-width-0">
                    <span class="fw-bolder text-truncate" t-esc="this.title"/>
                    <small class="text-muted text-truncate" t-esc="this.subtitle"/>
                </div>
                <button class="btn btn-sm btn-link text-muted p-0 o-mail-ComposePanel-headBtn o-mail-ComposePanel-skills"
                        t-on-click="this.onOpenSkillsOverview" title="Manage your quick actions — rename, share or delete them">
                    <i class="fa fa-fw fa-cog"/>
                </button>
                <button class="btn btn-sm btn-link text-muted p-0 o-mail-ComposePanel-headBtn o-mail-ComposePanel-chat"
                        t-on-click="this.onOpenInChat" title="Continue in the AI chat, where you can talk it through">
                    <i class="fa fa-fw fa-external-link"/>
                </button>
                <button class="btn btn-sm btn-link text-muted p-0 o-mail-ComposePanel-headBtn o-mail-ComposePanel-close"
                        t-on-click="() => this.props.close?.()" title="Close (Esc)">
                    <i class="fa fa-fw fa-times"/>
                </button>
            </div>

            <div class="o-mail-ComposePanel-body px-3 pb-3 pt-1">

                <div t-if="this.state.phase === 'error'"
                     class="o-mail-ComposePanel-error d-inline-flex align-items-center gap-1 mb-2 px-2 py-1 rounded-pill"
                     t-att-title="this.state.error">
                    <i class="fa fa-exclamation-circle"/>
                    <span class="text-truncate" t-esc="this.errorLabel"/>
                </div>

                <t t-if="this.state.phase === 'idle' or this.state.phase === 'error'">
                    <div t-if="this.isRewrite" class="o-mail-ComposePanel-quote mb-3 px-2 py-1 rounded small text-muted">
                        <span t-esc="this.quoted"/>
                    </div>
                    <div class="o-mail-ComposePanel-actions d-flex rounded-pill overflow-hidden">
                        <button t-foreach="this.groups" t-as="group" t-key="group.category"
                                class="btn btn-sm o-mail-ComposePanel-action flex-fill text-truncate"
                                t-att-class="this.state.opened === group.category ? 'o-active' : ''"
                                t-att-title="group.label"
                                t-on-click="() => this.onGroupClick(group)"
                                t-esc="group.label"/>
                    </div>

                    <t t-if="this.openGroup">
                        <div class="o-mail-ComposePanel-chips d-flex flex-wrap gap-1 mt-2">
                            <button t-foreach="this.openGroup.skills" t-as="skill" t-key="skill.name"
                                    class="btn btn-sm o-mail-ComposePanel-chip rounded-pill d-flex align-items-center gap-1"
                                    t-att-title="skill.description"
                                    t-on-click="() => this.onSkillClick(skill)">
                                <i class="fa fa-fw" t-att-class="skill.icon"/>
                                <span t-esc="skill.label"/>
                            </button>
                        </div>
                        <t t-if="this.openGroup.modifiers">
                            <div class="o-mail-ComposePanel-label text-uppercase text-muted mt-2 mb-1">Length</div>
                            <div class="btn-group btn-group-sm w-100 mb-2" role="group">
                                <button t-foreach="this.lengths" t-as="entry" t-key="entry.id"
                                        class="btn o-mail-ComposePanel-length"
                                        t-att-class="this.state.length === entry.id ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setLength(entry.id)"
                                        t-esc="entry.label"/>
                            </div>
                            <div class="o-mail-ComposePanel-label text-uppercase text-muted mb-1">Tone</div>
                            <div class="btn-group btn-group-sm w-100" role="group">
                                <button t-foreach="this.tones" t-as="entry" t-key="entry.id"
                                        class="btn o-mail-ComposePanel-tone"
                                        t-att-class="this.state.tone === entry.id ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setTone(entry.id)"
                                        t-esc="entry.label"/>
                            </div>
                        </t>
                    </t>

                    <div t-if="!this.state.createOpen" class="mt-2">
                        <button class="btn btn-sm o-mail-ComposePanel-chip o-mail-ComposePanel-chipNew rounded-pill d-flex align-items-center gap-1"
                                title="Create a quick action of your own"
                                t-on-click="() => this.onOpenCreate()">
                            <i class="fa fa-fw fa-plus"/>
                            <span>New quick action</span>
                        </button>
                    </div>
                    <div t-if="this.state.createOpen" class="o-mail-ComposePanel-createRow d-flex flex-column gap-1 mt-2">
                        <input type="text" class="form-control form-control-sm o-mail-ComposePanel-createLabel"
                               placeholder="Name the quick action…"
                               t-ref="this.createLabelRef"
                               t-att-value="this.state.createLabel"
                               t-on-input="(ev) => this.state.createLabel = ev.target.value"
                               t-on-keydown="this.onCreateKeydown"/>
                        <textarea class="form-control form-control-sm o-mail-ComposePanel-createBody" rows="2"
                                  t-att-placeholder="this.customPlaceholder"
                                  t-att-value="this.state.createBody"
                                  t-on-input="(ev) => this.state.createBody = ev.target.value"
                                  t-on-keydown="this.onCreateKeydown"/>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-primary o-mail-ComposePanel-createConfirm"
                                    t-on-click="this.onCreateConfirm"
                                    t-att-disabled="!this.state.createLabel.trim() or !this.state.createBody.trim() or this.state.saving">Save</button>
                            <button class="btn btn-sm btn-link text-muted o-mail-ComposePanel-createCancel"
                                    t-on-click="this.onCloseCreate">Cancel</button>
                        </div>
                    </div>

                    <div class="o-mail-ComposePanel-ask input-group input-group-sm mt-3">
                        <input type="text" class="form-control o-mail-ComposePanel-custom"
                               t-att-placeholder="this.customPlaceholder"
                               t-att-value="this.state.custom"
                               t-on-input="(ev) => this.state.custom = ev.target.value"
                               t-on-keydown="this.onCustomKeydown"/>
                        <button class="btn btn-primary o-mail-ComposePanel-send"
                                t-on-click="this.onCustomSubmit" t-att-disabled="!this.state.custom.trim()"
                                title="Ask">
                            <i class="fa fa-level-down fa-rotate-90"/>
                        </button>
                    </div>
                </t>

                <t t-if="this.isRunning">
                    <div class="o-mail-ComposePanel-busy d-flex align-items-center gap-2 mb-2">
                        <span class="o-mail-ComposePanel-pulse"/>
                        <span class="fw-medium" t-esc="this.busyLabel"/>
                        <button class="btn btn-sm btn-link text-muted ms-auto p-0 o-mail-ComposePanel-cancel"
                                t-on-click="this.onCancel">Cancel</button>
                    </div>
                    <div t-if="this.state.streaming" class="o-mail-ComposePanel-stream rounded p-2" t-esc="this.state.streaming"/>
                </t>

                <t t-if="this.state.phase === 'preview'">
                    <div t-if="this.diff" class="d-flex align-items-center gap-2 mb-1">
                        <small class="text-uppercase text-muted">What changes</small>
                        <small class="o-mail-ComposePanel-legend text-muted ms-auto">
                            <del class="o-mail-ComposePanel-removed px-1">removed</del>
                            <ins class="o-mail-ComposePanel-added px-1 ms-1">added</ins>
                        </small>
                    </div>
                    <div t-if="this.diff" class="o-mail-ComposePanel-diff rounded p-2 mb-3">
                        <t t-foreach="this.diff" t-as="part" t-key="part_index">
                            <span t-if="part.type === 'same'" t-esc="part.value"/>
                            <del t-if="part.type === 'removed'" class="o-mail-ComposePanel-removed" t-esc="part.value"/>
                            <ins t-if="part.type === 'added'" class="o-mail-ComposePanel-added" t-esc="part.value"/>
                        </t>
                    </div>
                    <div t-else="" class="o-mail-ComposePanel-result rounded p-2 mb-3" t-esc="this.state.result"/>

                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-primary o-mail-ComposePanel-accept d-flex align-items-center gap-1"
                                t-on-click="this.onAccept">
                            <i class="fa fa-check"/>
                            <span t-if="this.hasSelection">Replace selection</span>
                            <span t-elif="this.isRewrite">Replace message</span>
                            <span t-else="">Insert</span>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary o-mail-ComposePanel-retry d-flex align-items-center gap-1"
                                t-on-click="this.onRetry" title="Ask again for a different wording">
                            <i class="fa fa-repeat"/>
                            <span>Try again</span>
                        </button>
                        <button class="btn btn-sm btn-link text-muted ms-auto o-mail-ComposePanel-discard"
                                t-on-click="this.onDiscard">Discard</button>
                    </div>

                    <div t-if="this.canOfferSave and !this.state.saveOpen" class="mt-2 d-flex align-items-center gap-1 small">
                        <span class="text-muted">Ask this often?</span>
                        <button class="btn btn-sm btn-link p-0 o-mail-ComposePanel-saveOpen d-inline-flex align-items-center gap-1"
                                t-on-click="this.onOpenSave"
                                title="Keep this instruction as a quick action of this panel">
                            <i class="fa fa-fw fa-bolt"/>
                            <span>Save as quick action</span>
                        </button>
                    </div>
                    <div t-if="this.canOfferSave and this.state.saveOpen" class="input-group input-group-sm mt-2 o-mail-ComposePanel-saveRow">
                        <input type="text" class="form-control o-mail-ComposePanel-saveLabel"
                               placeholder="Name the quick action…"
                               t-ref="this.saveLabelRef"
                               t-att-value="this.state.saveLabel"
                               t-on-input="(ev) => this.state.saveLabel = ev.target.value"
                               t-on-keydown="this.onSaveKeydown"/>
                        <button class="btn btn-primary o-mail-ComposePanel-saveConfirm"
                                t-on-click="this.onSaveConfirm"
                                t-att-disabled="!this.state.saveLabel.trim() or this.state.saving"
                                title="Save">
                            <i class="fa fa-check"/>
                        </button>
                        <button class="btn btn-outline-secondary o-mail-ComposePanel-saveCancel"
                                t-on-click="this.onCloseSave" title="Cancel">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div t-if="this.state.savedLabel" class="mt-2 small text-muted o-mail-ComposePanel-saved d-flex align-items-center gap-1">
                        <i class="fa fa-fw fa-check"/>
                        <span>Saved — "<t t-esc="this.state.savedLabel"/>" is now a quick action of this panel.</span>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
