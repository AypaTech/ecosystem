<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.mcp_Playground">
        <div class="o_aypatech_mcp_playground d-flex h-100" t-ref="this.rootRef">
            <nav t-if="this.panels.length > 1" class="o_aypatech_mcp_panel_rail d-flex flex-column align-items-stretch border-end bg-light">
                <t t-foreach="this.panels" t-as="panel" t-key="panel.id">
                    <button type="button"
                        t-attf-class="o_aypatech_mcp_panel_tab btn btn-link {{ this.state.activePanel === panel.id ? 'active' : '' }}"
                        t-att-title="panel.label"
                        t-on-click="() => this.onSelectPanel(panel.id)"
                    >
                        <i t-if="panel.icon" t-attf-class="fa fa-fw fa-lg {{ panel.icon }}"/>
                        <span class="o_aypatech_mcp_panel_tab_label small" t-esc="panel.label"/>
                    </button>
                </t>
            </nav>
            <div class="o_aypatech_mcp_panel_body flex-grow-1 d-flex flex-column overflow-hidden">
                <t t-if="this.state.activePanel === this.toolsPanelId">
                    <KeyBar
                        client="this.client"
                        keyPrefix="this.state.keyPrefix"
                        onKeyChanged.bind="this.onKeyChanged"
                    />
                    <div class="o_aypatech_mcp_body flex-grow-1 d-flex overflow-hidden">
                        <div t-if="this.state.loading" class="m-auto text-muted">
                            Loading tools…
                        </div>
                        <t t-else="">
                            <ToolList
                                groups="this.filteredGroups"
                                selected="this.state.selected"
                                search="this.state.search"
                                onSearch.bind="this.onSearch"
                                onSelect.bind="this.onSelectTool"
                            />
                            <ToolDetail
                                tool="this.selectedTool"
                                response="this.state.response"
                                running="this.state.running"
                                hasKey="this.state.hasKey"
                                onTry.bind="this.onTryTool"
                            />
                        </t>
                    </div>
                </t>
                <t t-elif="this.activePanelDef and this.activePanelDef.component" t-att-key="this.state.activePanel">
                    <t t-component="this.activePanelDef.component"/>
                </t>
            </div>
        </div>
    </t>

    <t t-name="aypatech_ai_assistant.mcp_KeyBar">
        <div class="o_aypatech_mcp_keybar border-bottom p-2 d-flex align-items-center gap-2 flex-wrap">
            <span class="fw-bold">MCP Key</span>
            <span t-if="this.props.keyPrefix" class="badge text-bg-success">
                <i class="fa fa-key me-1"/>
                <t t-esc="this.props.keyPrefix"/>…
            </span>
            <span t-else="" class="badge text-bg-secondary">
                <i class="fa fa-unlock me-1"/>none
            </span>
            <div class="ms-2 d-flex align-items-center gap-1">
                <button
                    class="btn btn-sm btn-secondary"
                    t-on-click="this.onPasteToggle"
                >
                    <i class="fa fa-sign-in me-1"/>Use existing
                </button>
                <div class="vr mx-1"/>
                <select
                    class="form-select form-select-sm w-auto"
                    t-on-change="(ev) => this.state.scope = ev.target.value"
                >
                    <option value="read" t-att-selected="this.state.scope === 'read'">Read</option>
                    <option value="write" t-att-selected="this.state.scope === 'write'">Read &amp; Write</option>
                </select>
                <input
                    type="text"
                    class="form-control form-control-sm w-auto"
                    placeholder="Key label (optional)"
                    t-on-input="this.onPasteNameChange"
                    t-att-value="this.state.pasteName"
                />
                <button
                    class="btn btn-sm btn-primary"
                    t-on-click="this.onGenerate"
                >
                    <i class="fa fa-plus-circle me-1"/>Generate new
                </button>
                <button
                    t-if="this.props.keyPrefix"
                    class="btn btn-sm btn-outline-danger"
                    t-on-click="this.onClearKey"
                    title="Clear key from this tab"
                >
                    <i class="fa fa-times"/>
                </button>
            </div>
            <div class="text-muted small ms-auto">
                Keys are stored in sessionStorage (this tab only). Plaintext is never persisted server-side after generation.
            </div>
            <div t-if="this.state.pasting" class="w-100 d-flex gap-2 mt-2 align-items-center">
                <input
                    type="password"
                    class="form-control form-control-sm"
                    placeholder="Paste MCP key (Bearer token)…"
                    t-att-value="this.state.pasteValue"
                    t-on-input="this.onPasteChange"
                />
                <button class="btn btn-sm btn-primary text-nowrap" t-on-click="this.onPasteConfirm">
                    Use
                </button>
                <button class="btn btn-sm btn-link" t-on-click="this.onPasteToggle">
                    Cancel
                </button>
            </div>
        </div>
    </t>

    <t t-name="aypatech_ai_assistant.mcp_ToolList">
        <div class="o_aypatech_mcp_list border-end d-flex flex-column">
            <div class="p-2 border-bottom">
                <input
                    type="search"
                    class="form-control form-control-sm"
                    placeholder="Search tools…"
                    t-att-value="this.props.search"
                    t-on-input="this.props.onSearch"
                />
            </div>
            <div class="overflow-auto flex-grow-1">
                <div t-if="this.props.groups.length === 0" class="p-3 text-muted small">
                    No matching tools.
                </div>
                <t t-foreach="this.props.groups" t-as="group" t-key="group[0]">
                    <div class="o_aypatech_mcp_group_header px-2 py-1 small text-uppercase text-muted d-flex align-items-center gap-2">
                        <span t-attf-class="badge {{ this.categoryBadge(group[0]) }}">
                            <t t-esc="this.categoryLabel(group[0])"/>
                        </span>
                        <span class="ms-auto" t-esc="group[1].length"/>
                    </div>
                    <t t-foreach="group[1]" t-as="tool" t-key="tool.name">
                        <button
                            type="button"
                            t-attf-class="o_aypatech_mcp_tool btn btn-link text-start w-100 px-2 py-1 {{ this.props.selected === tool.name ? 'active' : '' }}"
                            t-on-click="() => this.props.onSelect(tool.name)"
                        >
                            <div class="fw-bold text-body" t-esc="tool.name"/>
                            <div class="small text-muted text-truncate" t-esc="tool.description"/>
                        </button>
                    </t>
                </t>
            </div>
        </div>
    </t>

    <t t-name="aypatech_ai_assistant.mcp_ToolDetail">
        <div class="o_aypatech_mcp_detail flex-grow-1 d-flex flex-column overflow-hidden" t-on-keydown="this.onKeyDown">
            <div t-if="!this.props.tool" class="m-auto text-muted">
                Select a tool from the list on the left.
            </div>
            <t t-else="">
                <div class="p-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="mb-0" t-esc="this.props.tool.name"/>
                        <span t-attf-class="badge {{ this.toolCategoryBadge }}" t-esc="this.props.tool.category"/>
                        <span t-if="this.props.tool.kind === 'db'" class="badge text-bg-light">DB</span>
                        <span t-if="this.props.tool.kind === 'method'" class="badge text-bg-light">Code</span>
                        <div class="ms-auto d-flex gap-1">
                            <button class="btn btn-sm btn-secondary" t-on-click="this.onCopyCurl">
                                <i class="fa fa-terminal me-1"/>curl
                            </button>
                            <button class="btn btn-sm btn-secondary" t-on-click="this.onCopyJsonRpc">
                                <i class="fa fa-code me-1"/>JSON-RPC
                            </button>
                        </div>
                    </div>
                    <div class="text-muted mt-1" t-esc="this.props.tool.description"/>
                </div>
                <ul class="nav nav-tabs px-3 pt-2 bg-light">
                    <li class="nav-item">
                        <a t-attf-class="nav-link {{ this.state.tab === 'form' ? 'active' : '' }}" href="#" t-on-click.prevent="() => this.onTabChange('form')">
                            Form
                        </a>
                    </li>
                    <li class="nav-item">
                        <a t-attf-class="nav-link {{ this.state.tab === 'schema' ? 'active' : '' }}" href="#" t-on-click.prevent="() => this.onTabChange('schema')">
                            Schema
                        </a>
                    </li>
                </ul>
                <div class="p-3 flex-grow-1 overflow-auto">
                    <div t-if="this.state.tab === 'form'">
                        <SchemaForm
                            schema="this.props.tool.inputSchema"
                            value="this.currentArgs"
                            onChange.bind="this.onArgsChange"
                        />
                    </div>
                    <pre t-if="this.state.tab === 'schema'" class="mb-0" t-esc="this.schemaJson"/>
                </div>
                <div class="p-3 border-top bg-light d-flex align-items-center gap-2">
                    <button
                        class="btn btn-primary"
                        t-att-disabled="this.props.running or !this.props.hasKey"
                        t-on-click="this.onRun"
                    >
                        <i t-if="this.props.running" class="fa fa-spinner fa-spin me-2"/>
                        <i t-else="" class="fa fa-play me-2"/>
                        <t t-esc="this.props.running ? 'Calling…' : 'Try it'"/>
                    </button>
                    <button class="btn btn-outline-secondary" t-on-click="this.onReset">
                        Reset args
                    </button>
                    <span t-if="!this.props.hasKey" class="text-danger small">
                        <i class="fa fa-exclamation-triangle me-1"/>Pick or generate an MCP key first.
                    </span>
                    <span t-else="" class="text-muted small d-none d-md-inline">
                        <kbd>Ctrl</kbd> + <kbd>Enter</kbd> to run
                    </span>
                    <span t-if="this.props.response" class="ms-auto small">
                        <span t-attf-class="fw-bold {{ this.statusClass }}">HTTP <t t-esc="this.props.response.status"/></span>
                        <span class="text-muted"> · <t t-esc="this.props.response.duration"/> ms</span>
                    </span>
                </div>
                <div t-if="this.props.response" class="p-3 border-top overflow-auto" style="max-height: 40%;">
                    <ResponsePanel response="this.props.response"/>
                </div>
            </t>
        </div>
    </t>

    <t t-name="aypatech_ai_assistant.mcp_SchemaForm">
        <div t-if="this.fields.length === 0" class="text-muted small">
            This tool takes no parameters.
        </div>
        <t t-else="">
            <t t-foreach="this.fields" t-as="field" t-key="field.name">
                <div class="mb-3">
                    <label class="form-label d-flex align-items-center gap-1">
                        <span class="fw-bold" t-esc="field.name"/>
                        <span t-if="field.required" class="text-danger">*</span>
                        <span class="badge text-bg-light" t-esc="field.schema.type or 'any'"/>
                    </label>
                    <div t-if="field.schema.description" class="form-text" t-esc="field.schema.description"/>
                    <t t-set="value" t-value="this.getValue(field.name)"/>
                    <t t-if="field.kind === 'enum'">
                        <select
                            class="form-select"
                            t-on-change="(ev) => this.onSelectChange(field.name, ev)"
                        >
                            <option value="">—</option>
                            <t t-foreach="field.schema.enum" t-as="opt" t-key="opt_index">
                                <option t-att-value="opt" t-att-selected="value === opt" t-esc="opt"/>
                            </t>
                        </select>
                    </t>
                    <t t-elif="field.kind === 'bool'">
                        <div class="form-check form-switch">
                            <input
                                type="checkbox"
                                class="form-check-input"
                                t-att-checked="value"
                                t-on-change="(ev) => this.onBoolChange(field.name, ev)"
                            />
                        </div>
                    </t>
                    <t t-elif="field.kind === 'int'">
                        <input
                            type="number"
                            step="1"
                            class="form-control"
                            t-att-value="value ?? ''"
                            t-on-input="(ev) => this.onIntChange(field.name, ev)"
                        />
                    </t>
                    <t t-elif="field.kind === 'number'">
                        <input
                            type="number"
                            step="any"
                            class="form-control"
                            t-att-value="value ?? ''"
                            t-on-input="(ev) => this.onNumberChange(field.name, ev)"
                        />
                    </t>
                    <t t-elif="field.kind === 'string'">
                        <input
                            type="text"
                            class="form-control"
                            t-att-value="value ?? ''"
                            t-on-input="(ev) => this.onStringChange(field.name, ev)"
                        />
                    </t>
                    <t t-else="">
                        <textarea
                            class="form-control font-monospace"
                            rows="4"
                            placeholder="JSON…"
                            t-on-input="(ev) => this.onJsonChange(field.name, ev)"
                            t-esc="this.jsonText(field.name)"
                        />
                        <div class="form-text">Enter JSON for this complex argument.</div>
                    </t>
                </div>
            </t>
        </t>
    </t>

    <t t-name="aypatech_ai_assistant.mcp_ResponsePanel">
        <div t-if="!this.props.response" class="text-muted small">
            Click "Try it" to run the tool.
        </div>
        <t t-else="">
            <div t-attf-class="alert {{ this.statusClass }} d-flex align-items-center gap-2 mb-2">
                <strong t-esc="this.statusLabel"/>
                <span t-if="this.props.response.exception" t-esc="this.props.response.exception"/>
            </div>
            <div t-if="this.blocks.length">
                <div class="small text-muted mb-1 d-flex align-items-center">
                    Result
                    <button t-if="this.prettyResult" class="btn btn-sm btn-link ms-auto p-0" t-on-click="this.onCopyResult" title="Copy text result">
                        <i class="fa fa-clipboard"/>
                    </button>
                </div>
                <t t-foreach="this.blocks" t-as="block" t-key="block_index">
                    <t t-if="block.type === 'text'">
                        <pre class="mb-3 p-2 bg-light border rounded" t-esc="this.formatTextBlock(block)"/>
                    </t>
                    <t t-elif="block.type === 'image'">
                        <div class="mb-3 p-2 bg-light border rounded">
                            <div class="small text-muted mb-1">image · <t t-esc="block.mimeType"/></div>
                            <img t-att-src="this.dataUri(block.mimeType, block.data)" class="img-fluid d-block"/>
                        </div>
                    </t>
                    <t t-elif="block.type === 'audio'">
                        <div class="mb-3 p-2 bg-light border rounded">
                            <div class="small text-muted mb-1">audio · <t t-esc="block.mimeType"/></div>
                            <audio controls="controls" t-att-src="this.dataUri(block.mimeType, block.data)"/>
                        </div>
                    </t>
                    <t t-elif="block.type === 'resource'">
                        <div class="mb-3 p-2 bg-light border rounded">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge text-bg-secondary" t-esc="block.resource.mimeType or 'binary'"/>
                                <code class="small text-truncate flex-grow-1" t-esc="block.resource.uri"/>
                                <a t-if="block.resource.blob"
                                   t-att-href="this.dataUri(block.resource.mimeType, block.resource.blob)"
                                   t-att-download="this.downloadName(block)"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fa fa-download me-1"/>Download
                                </a>
                            </div>
                            <pre t-if="block.resource.text" class="mb-0 mt-2 small" t-esc="block.resource.text"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="mb-3 p-2 bg-light border rounded text-muted small">
                            Unknown content block type: <code t-esc="block.type"/>
                        </div>
                    </t>
                </t>
            </div>
            <details>
                <summary class="small text-muted d-flex align-items-center">
                    Raw JSON-RPC response
                    <button class="btn btn-sm btn-link ms-auto p-0" t-on-click.stop.prevent="this.onCopyRaw" title="Copy raw">
                        <i class="fa fa-clipboard"/>
                    </button>
                </summary>
                <pre class="mt-2 p-2 bg-light border rounded small" t-esc="this.rawBody"/>
            </details>
        </t>
    </t>

</templates>
