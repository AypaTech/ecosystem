<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.ai_ToolGroup">
        <div class="ayp_tool_group"
             t-att-class="errCount ? 'ayp_tool_group_has_error' : ''"
             t-att-data-expanded="state.expanded ? 1 : 0">
            <button type="button" class="ayp_tool_group_head" t-on-click="() => this.toggle()">
                <i class="fa fa-chevron-right ayp_chevron"/>
                <span class="ayp_tool_group_icon d-inline-flex align-items-center justify-content-center">
                    <i class="fa fa-wrench"/>
                </span>
                <span class="ayp_tool_group_label">Used <t t-esc="count"/> tools</span>
                <span class="ayp_tool_group_chips" t-if="!props.compact">
                    <t t-foreach="chips.shown" t-as="nm" t-key="nm_index">
                        <span class="ayp_tool_group_chip" t-esc="nm"/>
                    </t>
                    <span t-if="chips.hasMore" class="ayp_tool_group_chip ayp_tool_group_chip_more">…</span>
                </span>
                <span t-else="" class="ayp_tool_group_spacer"/>
                <span class="ayp_tool_group_status">
                    <span t-if="okCount" class="ayp_tg_badge ayp_tg_ok">
                        <i class="fa fa-check"/> <t t-esc="okCount"/>
                    </span>
                    <span t-if="errCount" class="ayp_tg_badge ayp_tg_err">
                        <i class="fa fa-times"/> <t t-esc="errCount"/>
                    </span>
                </span>
            </button>
            <div class="ayp_tool_group_body" t-if="state.expanded">
                <t t-foreach="props.tools" t-as="tool" t-key="tool.block.callId || tool_index">
                    <ToolCard
                        block="tool.block"
                        expanded="props.isToolExpanded(tool.block.callId)"
                        streaming="false"
                        onToggle="props.onToggleTool"
                    />
                </t>
            </div>
        </div>
    </t>

</templates>
