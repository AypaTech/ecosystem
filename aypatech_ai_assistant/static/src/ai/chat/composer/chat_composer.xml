<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.ai_ChatComposer">
        <div class="ayp_composer_host position-relative">
        <div class="ayp_composer_readonly" t-if="this.props.readonly">
            <i class="fa fa-eye"/>
            <span t-esc="this.readonlyNotice"/>
        </div>
        <t t-else="">
        <div class="ayp_slash_popover" t-if="this.showSlashMenu">
            <t t-if="this.isAgentMode">
                <t t-foreach="this.agentMatches" t-as="agent" t-key="agent.id">
                    <button
                        type="button"
                        class="ayp_slash_item"
                        t-att-class="{ active: agent_index === this.localState.slashActive }"
                        t-on-click="() => this.pickAgent(agent_index)"
                        t-on-mouseenter="() => this.hoverSlashCommand(agent_index)"
                    >
                        <span class="ayp_slash_name" t-esc="agent.name"/>
                        <span class="ayp_slash_hint" t-if="agent.id === this.props.activeAgentId">active</span>
                        <span class="ayp_slash_hint" t-elif="agent.description" t-esc="agent.description"/>
                    </button>
                </t>
            </t>
            <t t-else="">
                <t t-foreach="this.slashCommands" t-as="cmd" t-key="cmd.name">
                    <button
                        type="button"
                        class="ayp_slash_item"
                        t-att-class="{ active: cmd_index === this.localState.slashActive }"
                        t-on-click="() => this.pickSlashCommand(cmd_index)"
                        t-on-mouseenter="() => this.hoverSlashCommand(cmd_index)"
                    >
                        <code class="ayp_slash_name" t-esc="cmd.name"/>
                        <span class="ayp_slash_hint" t-esc="cmd.hint"/>
                    </button>
                </t>
            </t>
        </div>
        <div class="ayp_composer d-flex flex-column gap-2">
            <div class="ayp_attachments d-flex flex-wrap gap-2" t-if="this.props.attachments.length">
                <t t-foreach="this.props.attachments" t-as="attachment" t-key="attachment.id">
                    <AttachmentCard
                        attachment="attachment"
                        removable="true"
                        compact="true"
                        onOpen.bind="this.onOpenAttachment"
                        onRemove.bind="this.onRemoveAttachment"
                    />
                </t>
            </div>
            <div class="ayp_composer_row d-flex align-items-end gap-2">
                <label
                    class="btn ayp_attach rounded-circle mb-0"
                    t-att-class="{ 'ayp_attach_disabled': !this.props.canAttach }"
                    t-att-for="this.fileInputId"
                    t-on-click="(ev) => this.onLabelClick(ev)"
                    title="Attach file"
                >
                    <i class="fa fa-paperclip"/>
                </label>
                <input
                    type="file"
                    class="ayp_file_input"
                    t-ref="this.fileInputRef"
                    t-att-id="this.fileInputId"
                    multiple="multiple"
                    t-att-accept="this.accept"
                    t-att-disabled="!this.props.canAttach ? 'disabled' : null"
                    t-on-change="(ev) => this.onFileInputChange(ev)"
                />
                <textarea
                    class="form-control border-0 shadow-none"
                    rows="1"
                    t-ref="this.inputRef"
                    t-on-input="(ev) => this.onInputChange(ev)"
                    t-on-keydown="(ev) => this.onKeydown(ev)"
                    t-on-paste="(ev) => this.onPaste(ev)"
                    t-att-placeholder="this.props.placeholder"
                />
                <button
                    class="btn ayp_send rounded-circle"
                    t-att-class="(this.props.canSend and this.props.isQueueing) ? 'ayp_queue' : (this.props.canStop and !this.props.canSend) ? 'ayp_stop' : ''"
                    t-on-click="() => this.onSendOrStop()"
                    t-att-disabled="(!this.props.canStop and !this.props.canSend) ? 'disabled' : null"
                    t-att-title="(this.props.canSend and this.props.isQueueing) ? 'Queue (sends after current turn)' : (this.props.canStop and !this.props.canSend) ? 'Stop' : 'Send'"
                >
                    <i class="fa" t-att-class="(this.props.canSend and this.props.isQueueing) ? 'fa-clock-o' : (this.props.canStop and !this.props.canSend) ? 'fa-stop' : 'fa-arrow-up'"/>
                </button>
            </div>
        </div>
        </t>
        </div>
    </t>

</templates>
