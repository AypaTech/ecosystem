<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.ai_ChatWindowContainer">
        <div
            class="ayp_window_dock"
            t-attf-style="--ayp-discuss-reserved: {{ discussReservedWidth }}px; --ayp-dock-width: {{ dockWidth }}px"
        >
            <t t-foreach="state.windows" t-as="w" t-key="w.sessionId">
                <ChatWindow
                    sessionId="w.sessionId"
                    minimized="w.minimized"
                    onClose="() => cw.close(w.sessionId)"
                    onToggleMinimized="() => cw.toggleMinimized(w.sessionId)"
                />
            </t>
        </div>
    </t>

</templates>
