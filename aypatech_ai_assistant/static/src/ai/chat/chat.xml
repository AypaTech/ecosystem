<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.ai_Chat">
        <div class="ayp_chat d-flex flex-column h-100 position-relative" t-ref="this.rootRef">
            <t t-call="aypatech_ai_assistant.ai_ChatMainHeader"/>
            <div class="ayp_chat_body d-flex flex-grow-1 position-relative">
            <ChatSidebar
                t-if="!this.state.sidebarHidden"
                sessions="this.state.sessions"
                spaces="this.state.spaces"
                spaceSessions="this.state.spaceSessions"
                spaceUnread="this.badge.spaceUnread"
                unreadIds="this.badge.unreadIds"
                activeSessionId="this.session.state.sessionId"
                hasMore="this.state.sessionsHasMore"
                loadingMore="this.state.sessionsLoadingMore"
                searching="this.state.sessionsSearching"
                searchMode="this.state.sessionsSearchMode"
                onNew="() => this.onNewSession()"
                onSelect.bind="this.onSelectSession"
                onRename.bind="this.onRenameSession"
                onDelete.bind="this.onDeleteSession"
                onQuery.bind="this.onSidebarQuery"
                onLoadMore.bind="this.onSidebarLoadMore"
                onSpaceOpen.bind="this.onSpaceOpen"
                onSpaceCreate.bind="this.onSpaceCreate"
                onSpaceEdit.bind="this.onSpaceEdit"
                onSpaceDelete.bind="this.onSpaceDelete"
                onSpaceReorder.bind="this.onSpaceReorder"
                onSpaceNew.bind="this.onSpaceNew"
                onSpaceLoadMore.bind="this.onSpaceLoadMore"
                onSessionFile.bind="this.onSessionFile"
            />
            <div
                class="ayp_sidebar_backdrop"
                t-if="!this.state.sidebarHidden"
                t-on-click="() => this.toggleSidebar()"
            />
            <main class="ayp_main d-flex flex-column flex-grow-1">
                <ChatSearch
                    t-if="this.state.searchOpen"
                    query="this.state.searchQuery"
                    total="this.searchMatches.length"
                    currentIdx="this.clampedActiveMatchIdx"
                    onChange.bind="this.onSearchChange"
                    onPrev.bind="this.onSearchPrev"
                    onNext.bind="this.onSearchNext"
                    onClose.bind="this.closeSearch"
                />
                <t t-if="this.state.loading">
                    <div class="flex-grow-1 d-flex align-items-center justify-content-center text-muted">
                        <i class="fa fa-spinner fa-spin me-2"/>
                        <span>Loading…</span>
                    </div>
                </t>
                <t t-elif="!this.session.state.sessionId">
                    <div class="ayp_empty flex-grow-1 d-flex flex-column align-items-center justify-content-center">
                        <div class="ayp_empty_badge d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm">
                            <i class="fa fa-comments-o"/>
                        </div>
                        <h2 class="fw-semibold mb-1">How can I help you today?</h2>
                        <p t-if="this.suggestions.length" class="text-muted mb-0">Start a new chat or pick a suggestion to begin.</p>
                        <p t-else="" class="text-muted mb-0">Start a new chat to begin.</p>
                        <div t-if="this.suggestions.length" class="ayp_suggestions">
                            <t t-foreach="this.suggestions" t-as="s" t-key="s_index">
                                <button class="ayp_suggestion" t-on-click="() => this.onStartWithPrompt(s.prompt)">
                                    <span class="ayp_suggestion_label" t-esc="s.label"/>
                                    <span class="ayp_suggestion_preview" t-esc="s.prompt"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="ayp_messages_wrap flex-grow-1 position-relative d-flex flex-column">
                        <button t-if="!this.scrollState.atBottom"
                                class="ayp_scroll_bottom"
                                type="button"
                                title="Scroll to latest"
                                t-on-click="() => this.scrollToBottom(true)">
                            <i class="fa fa-arrow-down"/>
                        </button>
                        <div class="ayp_messages flex-grow-1" t-ref="this.scrollRef">
                        <div class="ayp_messages_inner">
                            <div t-if="this.session.state.hasMoreOlder" class="ayp_load_older text-center small text-muted py-2">
                                <t t-if="this.session.state.loadingOlder">
                                    <i class="fa fa-spinner fa-spin me-1"/>Loading…
                                </t>
                                <t t-else="">
                                    <button class="btn btn-link btn-sm" t-on-click="() => this.session.loadMoreEvents()">
                                        Load older messages
                                    </button>
                                </t>
                            </div>
                            <t t-if="!this.renderedTurns.length and this.session.state.status !== 'running' and !this.session.state.pendingMessages.length">
                                <div class="ayp_empty_inline d-flex flex-column align-items-center justify-content-center text-center py-5">
                                    <div class="ayp_empty_badge d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm mb-3">
                                        <i class="fa fa-comments-o"/>
                                    </div>
                                    <p t-if="this.suggestions.length" class="text-muted mb-3">Type a message below or pick a suggestion.</p>
                                    <p t-else="" class="text-muted mb-3">Type a message below to begin.</p>
                                    <div t-if="this.suggestions.length" class="ayp_suggestions">
                                        <t t-foreach="this.suggestions" t-as="s" t-key="s_index">
                                            <button class="ayp_suggestion" t-on-click="() => this.onSubmitSuggestion(s.prompt)">
                                                <span class="ayp_suggestion_label" t-esc="s.label"/>
                                                <span class="ayp_suggestion_preview" t-esc="s.prompt"/>
                                            </button>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <t t-foreach="this.renderedTurns" t-as="turn" t-key="turn.clientKey || (turn.eventId ? 'e' + turn.eventId : turn_index + '-' + (turn.at || ''))">
                                <t t-call="aypatech_ai_assistant.ai_ChatTurn">
                                    <t t-set="turn" t-value="turn"/>
                                </t>
                            </t>
                            <t t-if="this.session.state.status === 'running'">
                                <div class="ayp_turn ayp_turn_assistant">
                                    <t t-foreach="this.session.state.streamingTools" t-as="tool" t-key="tool.callId">
                                        <ToolCard
                                            block="{ name: tool.name, arguments: tool.argsBuffer, callId: tool.callId, result: tool.done ? tool.result : null }"
                                            streaming="!tool.done"
                                        />
                                    </t>
                                    <div
                                        class="ayp_bubble ayp_bubble_assistant ayp_markdown ayp_streaming"
                                        t-if="this.session.state.streamingText or this.session.state.streamingReasoning or !this.session.state.streamingTools.length"
                                    >
                                        <t t-if="this.session.state.streamingText" t-out="this.renderMarkdown(this.session.state.streamingText)"/>
                                        <span t-else="" class="ayp_thinking">
                                            <span class="ayp_dots"><span/><span/><span/></span>
                                            <span class="ayp_thinking_status" t-esc="this.session.state.streamingReasoning ? this.session.latestReasoningLine() : 'Thinking'"/>
                                        </span>
                                        <div t-if="this.session.state.streamIdle and this.session.state.streamingText" class="ayp_thinking ayp_thinking_idle mt-1">
                                            <span class="ayp_dots"><span/><span/><span/></span>
                                            <span class="ayp_thinking_status" t-esc="this.session.state.streamingReasoning ? this.session.latestReasoningLine() : 'Still working…'"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-foreach="this.session.state.pendingMessages" t-as="queued" t-key="queued_index">
                                <div class="ayp_turn ayp_turn_user ayp_turn_queued">
                                    <div class="ayp_bubble ayp_bubble_user ayp_bubble_queued shadow-sm" t-att-title="queued.queued_at || ''">
                                        <i class="fa fa-clock-o me-2"/>
                                        <span t-esc="queued.content"/>
                                        <button
                                            class="btn btn-sm ayp_queue_cancel"
                                            type="button"
                                            t-if="this.session.canWrite()"
                                            title="Cancel queued message"
                                            t-on-click="() => this.session.cancelQueued(queued_index)"
                                        >
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </div>
                            </t>
                            <t t-if="this.session.state.error">
                                <div class="alert alert-danger rounded-3 mt-3 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
                                    <div class="text-break">
                                        <strong><i class="fa fa-exclamation-circle me-1"/>Error:</strong>
                                        <span t-esc="this.session.state.error"/>
                                    </div>
                                    <button t-if="this.session.canRegenerate()"
                                            class="btn btn-sm btn-outline-danger flex-shrink-0 align-self-end align-self-sm-auto"
                                            type="button"
                                            title="Regenerate this answer"
                                            t-on-click="() => this.session.onRegenerate()">
                                        <i class="fa fa-refresh me-1"/>Regenerate
                                    </button>
                                </div>
                            </t>
                        </div>
                        </div>
                    </div>
                    <AIChatShareUsers
                        t-if="this.session.state.sessionId"
                        sessionId="this.session.state.sessionId"
                        readonly="this.session.state.readonly"
                        shareIds="this.session.state.shareIds"
                        onChanged.bind="this.onShareChanged"
                    />
                    <div class="ayp_composer_wrap">
                        <ChatComposer
                            value="this.session.state.input"
                            placeholder="this.inputPlaceholder"
                            readonly="this.session.state.readonly"
                            readonlyOwner="this.session.state.ownerName"
                            canSend="this.session.canSend()"
                            canStop="this.session.canStop()"
                            canAttach="this.session.canAttach()"
                            isQueueing="this.isQueueing"
                            attachments="this.session.state.pendingAttachments"
                            agents="this.session.state.agents"
                            sessionId="this.session.state.sessionId"
                            viewContext="this.session.state.viewContext"
                            activeAgentId="this.session.state.agentId"
                            focusToken="this.session.state.focusToken"
                            onInput.bind="this.onInputChange"
                            onSend.bind="this.onSend"
                            onStop.bind="this.onStop"
                            onAttachFiles.bind="this.onAttachFiles"
                            onRemoveAttachment.bind="this.onRemoveAttachment"
                            onOpenAttachment.bind="this.onOpenAttachment"
                            onSelectAgent="(agentId) => this.session.onSetAgent(agentId)"
                        />
                        <div
                            class="ayp_composer_hint mt-1 ps-1"
                            t-att-class="{ 'd-none': this.session.state.readonly }"
                        >
                            <span><kbd>Enter</kbd> to send</span>
                            <span><kbd>Shift</kbd>+<kbd>Enter</kbd> for newline</span>
                        </div>
                    </div>
                </t>
            </main>
            <ChatArtifactsPanel
                t-if="!this.state.artifactsHidden"
                session="this.session"
                onClose="() => this.closeArtifacts()"
                onOpenAttachment.bind="this.onOpenAttachment"
            />
            </div>
        </div>
    </t>

    <t t-name="aypatech_ai_assistant.ai_ChatMainHeader">
        <div class="ayp_main_header d-flex align-items-center gap-2">
            <button
                class="btn btn-link btn-sm ayp_sidebar_toggle p-1"
                t-on-click="() => this.toggleSidebar()"
                title="Toggle sidebar"
            >
                <svg
                    class="ayp_sidebar_icon"
                    viewBox="0 0 15 15"
                    fill="currentColor"
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    aria-hidden="true"
                >
                    <path
                        t-if="!this.state.sidebarHidden"
                        class="ayp_sidebar_icon_pane"
                        d="M2 2h2v11h-2a1 1 0 0 1 -1 -1v-9a1 1 0 0 1 1 -1Z"
                    />
                    <path d="M2 1h11a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-11a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2ZM2 2h2v11h-2a1 1 0 0 1 -1 -1v-9a1 1 0 0 1 1 -1ZM5 2h8a1 1 0 0 1 1 1v9a1 1 0 0 1 -1 1h-8v-11Z"/>
                </svg>
            </button>
            <span
                class="ayp_avatar rounded-circle"
                t-if="this.session.state.sessionId"
                t-att-class="this.statusBadgeClass(this.session.state.status)"
                t-att-title="this.statusLabel(this.session.state.status)"
            >
                <i class="fa" t-att-class="this.statusIcon(this.session.state.status)"/>
            </span>
            <span class="ayp_main_title" t-esc="this.session.state.name || 'AypaTech AI Chat'"/>
            <span
                t-if="this.session.state.sessionId and !this.session.canWrite()"
                class="btn btn-sm ayp_agent_pill rounded-pill d-inline-flex align-items-center gap-1 disabled"
                title="The agent of a shared chat cannot be changed"
            >
                <i class="fa fa-user-circle-o"/>
                <span t-esc="this.session.state.agentName || 'No agent'"/>
            </span>
            <Dropdown t-if="this.session.state.sessionId and this.session.state.agents.length and this.session.canWrite()">
                <button class="btn btn-sm ayp_agent_pill rounded-pill d-inline-flex align-items-center gap-1" title="Switch agent">
                    <i class="fa fa-user-circle-o"/>
                    <span t-esc="this.session.state.agentName || 'No agent'"/>
                    <i class="fa fa-caret-down small"/>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="this.session.state.agents" t-as="agent" t-key="agent.id">
                        <DropdownItem
                            class="{ 'active': session.state.agentId === agent.id }"
                            onSelected="() => this.session.onSetAgent(agent.id)"
                        >
                            <div class="d-flex flex-column">
                                <span class="fw-semibold" t-esc="agent.name"/>
                                <small class="text-muted" t-if="agent.description" t-esc="agent.description"/>
                            </div>
                        </DropdownItem>
                    </t>
                    <DropdownItem
                        class="{ 'active': !session.state.agentId }"
                        onSelected="() => this.session.onSetAgent(null)"
                    >
                        <span class="text-muted fst-italic">No agent (defaults)</span>
                    </DropdownItem>
                </t>
            </Dropdown>
            <span
                t-if="this.session.state.loading and this.session.state.sessionId"
                class="ayp_chat_header_loading text-muted small d-inline-flex align-items-center gap-1"
                title="Loading session"
            >
                <i class="fa fa-spinner fa-spin"/>
            </span>
            <span
                t-if="this.session.state.status === 'waiting_schedule' and this.session.state.resumeAt"
                class="ayp_chat_header_resume text-muted small"
                t-att-title="this.formatTimestamp(this.session.state.resumeAt)"
            >
                <t t-esc="this.resumeRelativeText"/>
            </span>
            <button
                t-if="this.session.state.sessionId"
                class="btn btn-sm ayp_approval_pill rounded-pill border-0 d-inline-flex align-items-center gap-1"
                t-att-class="this.approvalPill.className"
                t-att-title="this.approvalPill.tooltip"
                t-att-disabled="!this.session.canWrite()"
                t-on-click="() => this.session.cycleApprovalMode()"
            >
                <i class="fa" t-att-class="this.approvalPill.icon"/>
                <span t-esc="this.approvalPill.label"/>
            </button>
            <div class="ayp_tokens ms-auto d-flex align-items-center gap-2" t-if="this.session.state.sessionId">
                <button
                    class="btn btn-link btn-sm ayp_search_toggle"
                    t-att-class="{ active: this.state.searchOpen }"
                    t-on-click="() => this.toggleSearch()"
                    title="Search this chat"
                >
                    <i class="fa fa-search"/>
                </button>
                <button
                    class="btn btn-link btn-sm ayp_artifacts_toggle"
                    t-att-class="{ active: !this.state.artifactsHidden }"
                    t-on-click="() => this.toggleArtifacts()"
                    title="Toggle artifacts panel"
                >
                    <i class="fa fa-paperclip"/>
                </button>
                <button
                    t-if="this.session.canWrite()"
                    class="btn btn-link btn-sm ayp_handover"
                    title="Hand over this chat to another user"
                    t-on-click="() => this.session.openHandoverPicker()"
                >
                    <i class="fa fa-share-square-o"/>
                </button>
                <button
                    class="btn btn-link btn-sm ayp_popout"
                    title="Pop out chat to a floating window"
                    t-on-click="() => this.onPopout()"
                >
                    <i class="fa fa-external-link"/>
                </button>
                <span
                    class="ayp_chip ayp_ctx_chip rounded-pill"
                    t-if="this.session.state.viewContext"
                >
                    <button
                        class="btn btn-link p-0 border-0 text-reset text-decoration-none d-inline-flex align-items-center"
                        t-att-title="this.viewContextTooltip"
                        t-on-click="() => this.session.openPinnedContext()"
                    >
                        <i class="fa fa-thumb-tack mt-1 me-1"/><t t-esc="this.viewContextLabel"/>
                    </button>
                    <button
                        class="btn btn-link p-0 border-0 text-reset ms-1 ayp_ctx_unpin"
                        t-if="this.session.canWrite()"
                        title="Unpin view context"
                        t-on-click="() => this.session.runUnpin()"
                    >
                        <i class="fa fa-times"/>
                    </button>
                </span>
                <span
                    class="ayp_chip ayp_context_chip rounded-pill"
                    t-att-class="this.contextClass"
                    t-att-title="this.contextTooltip"
                    t-if="this.session.state.contextWindow"
                >
                    <span class="ayp_context_ring" t-att-style="`--pct:${this.contextPercent}`"/><t t-esc="this.contextPercent"/>%
                </span>
                <span class="ayp_chip rounded-pill" title="Iterations">
                    <i class="fa fa-repeat"/><t t-esc="this.session.state.iterationCount"/>
                </span>
                <span class="ayp_chip rounded-pill" title="Input tokens">
                    <i class="fa fa-sign-in"/><t t-esc="this.session.state.inputTokens"/>
                </span>
                <span class="ayp_chip rounded-pill" title="Output tokens">
                    <i class="fa fa-sign-out"/><t t-esc="this.session.state.outputTokens"/>
                </span>
                <span class="ayp_chip ayp_cost_chip rounded-pill" t-att-title="this.costPill.tooltip">
                    <i class="fa fa-dollar"/><t t-esc="this.costPill.label"/>
                </span>
            </div>
        </div>
    </t>

    <t t-name="aypatech_ai_assistant.ai_ChatTurn">
        <t t-if="turn.role === 'user'">
            <div class="ayp_turn ayp_turn_user" t-att-class="turn.inHistory ? 'ayp_turn_in_history' : ''">
                <div
                    class="ayp_bubble ayp_bubble_user shadow-sm"
                    t-att-id="'ayp_msg_' + turn_index + '_user'"
                    t-att-title="turn.at || ''"
                >
                    <t t-if="turn.text">
                        <t t-out="this.renderUserText(turn.text)"/>
                    </t>
                    <div class="ayp_bubble_attachments d-flex flex-wrap gap-2 mt-2" t-if="turn.attachments and turn.attachments.length">
                        <t t-foreach="turn.attachments" t-as="attachment" t-key="attachment.id">
                            <AttachmentCard
                                attachment="attachment"
                                onOpen.bind="this.onOpenAttachment"
                            />
                        </t>
                    </div>
                    <t t-call="aypatech_ai_assistant.ai_ChatMsgMeta">
                        <t t-set="meta_at" t-value="turn.at"/>
                        <t t-set="meta_text" t-value="turn.text"/>
                        <t t-set="meta_event_id" t-value="turn.eventId"/>
                        <t t-set="meta_side" t-value="'ayp_msg_meta_right'"/>
                        <t t-set="meta_in_history" t-value="turn.inHistory"/>
                    </t>
                </div>
            </div>
        </t>
        <t t-elif="turn.role === 'command'">
            <div class="ayp_turn ayp_turn_command" t-att-title="turn.at || ''">
                <div class="ayp_context_divider" role="separator" aria-label="Context boundary">
                    <span class="ayp_context_divider_line"/>
                    <span class="ayp_context_divider_label">
                        <code t-esc="turn.name"/>
                        <t t-if="turn.originalMessages or turn.originalTokens">
                            <span class="ayp_context_divider_sep">·</span>
                            <span class="ayp_context_divider_meta">compacted <t t-esc="turn.originalMessages"/> msgs / <t t-esc="turn.originalTokens"/> tokens</span>
                        </t>
                        <t t-elif="turn.message">
                            <span class="ayp_context_divider_sep">·</span>
                            <span class="ayp_context_divider_meta" t-esc="turn.message"/>
                        </t>
                    </span>
                    <span class="ayp_context_divider_line"/>
                </div>
                <div class="ayp_context_divider_summary ayp_markdown" t-if="turn.summary" t-out="this.renderMarkdown(turn.summary)"/>
            </div>
        </t>
        <t t-elif="turn.role === 'compact_progress'">
            <div class="ayp_turn ayp_turn_command ayp_turn_compact_progress" t-att-title="turn.at || ''">
                <t t-if="turn.state === 'streaming'">
                    <div class="ayp_compact_card">
                        <div class="ayp_compact_card_head">
                            <i class="fa fa-circle-o-notch fa-spin ayp_compact_spinner"/>
                            <span class="ayp_compact_card_title">
                                <t t-esc="turn.auto ? 'Auto-compacting' : 'Compacting'"/>
                            </span>
                            <span class="ayp_compact_card_meta">
                                · <t t-esc="turn.messageCount"/> msgs
                                <t t-if="turn.tokensEstimate"> · ~<t t-esc="turn.tokensEstimate"/> tokens</t>
                            </span>
                            <button
                                class="btn btn-sm btn-link ayp_compact_stop"
                                t-if="this.session.canWrite()"
                                t-on-click="() => this.session.runStopCompact()"
                            >
                                <i class="fa fa-stop me-1"/>Stop
                            </button>
                        </div>
                        <div class="ayp_compact_card_body ayp_markdown" t-if="turn.streamedText"
                             t-out="this.renderMarkdown(turn.streamedText)"/>
                        <div class="ayp_compact_card_body text-muted small" t-else="">
                            Summarizing conversation…
                        </div>
                    </div>
                </t>
                <t t-elif="turn.state === 'done'">
                    <div class="ayp_context_divider" role="separator" aria-label="Compaction boundary">
                        <span class="ayp_context_divider_line"/>
                        <span class="ayp_context_divider_label">
                            <code><t t-esc="turn.auto ? 'auto-compact' : '/compact'"/></code>
                            <span class="ayp_context_divider_sep">·</span>
                            <span class="ayp_context_divider_meta">compacted <t t-esc="turn.originalMessages"/> msgs / <t t-esc="turn.originalTokens"/> tokens</span>
                        </span>
                        <span class="ayp_context_divider_line"/>
                    </div>
                    <details class="ayp_compact_summary_details" t-if="turn.summary">
                        <summary class="ayp_compact_summary_toggle">Show summary</summary>
                        <div class="ayp_context_divider_summary ayp_markdown"
                             t-out="this.renderMarkdown(turn.summary)"/>
                    </details>
                </t>
                <t t-elif="turn.state === 'cancelled'">
                    <div class="ayp_context_divider" role="separator" aria-label="Compaction cancelled">
                        <span class="ayp_context_divider_line"/>
                        <span class="ayp_context_divider_label ayp_context_divider_label_muted">
                            <code><t t-esc="turn.auto ? 'auto-compact' : '/compact'"/></code>
                            <span class="ayp_context_divider_sep">·</span>
                            <span class="ayp_context_divider_meta" t-esc="turn.message || 'cancelled'"/>
                        </span>
                        <span class="ayp_context_divider_line"/>
                    </div>
                </t>
                <t t-elif="turn.state === 'error'">
                    <div class="ayp_compact_card ayp_compact_card_error">
                        <div class="ayp_compact_card_head">
                            <i class="fa fa-exclamation-triangle me-2 text-danger"/>
                            <span class="ayp_compact_card_title">Compaction failed</span>
                        </div>
                        <div class="ayp_compact_card_body text-muted small" t-esc="turn.error"/>
                    </div>
                </t>
            </div>
        </t>
        <t t-else="">
            <div class="ayp_turn ayp_turn_assistant" t-att-class="turn.inHistory ? 'ayp_turn_in_history' : ''">
                <t t-foreach="this.turnItems(turn)" t-as="item" t-key="item.key">
                    <t t-set="block" t-value="item.block"/>
                    <t t-set="block_index" t-value="item.blockIndex"/>
                    <t t-if="item.type === 'text'">
                        <div
                            class="ayp_bubble ayp_bubble_assistant ayp_markdown"
                            t-att-id="'ayp_msg_' + turn_index + '_' + block_index"
                        >
                            <t t-call="aypatech_ai_assistant.ai_ChatMsgMeta">
                                <t t-set="meta_at" t-value="block.at || turn.at"/>
                                <t t-set="meta_text" t-value="block.text"/>
                                <t t-set="meta_event_id" t-value="block.eventId || turn.eventId"/>
                                <t t-set="meta_side" t-value="''"/>
                                <t t-set="meta_in_history" t-value="turn.inHistory"/>
                                <t t-set="meta_can_regenerate" t-value="block_index === turn.regenerateAt and this.session.canRegenerate()"/>
                            </t>
                            <div class="ayp_bubble_body" t-out="this.renderAssistantMarkdown(block.text)"/>
                        </div>
                    </t>
                    <t t-elif="item.type === 'tool'">
                        <ToolCard
                            t-if="!this.isToolHiddenForAsk(block, turn)"
                            block="block"
                            expanded="this.isToolExpanded(block.callId)"
                            streaming="this.isToolStreaming(block)"
                            onToggle.bind="this.toggleToolBlock"
                        />
                    </t>
                    <t t-elif="item.type === 'group'">
                        <ToolGroup
                            tools="item.tools"
                            compact="this.isCompact"
                            isToolExpanded.bind="this.isToolExpanded"
                            onToggleTool.bind="this.toggleToolBlock"
                        />
                    </t>
                    <t t-elif="item.type === 'ask'">
                        <t t-call="aypatech_ai_assistant.ai_AskCard">
                            <t t-set="block" t-value="block"/>
                        </t>
                    </t>
                </t>
                <div
                    class="ayp_bubble_attachments d-flex flex-wrap gap-2 mt-2"
                    t-if="turn.attachments and turn.attachments.length"
                >
                    <t t-foreach="turn.attachments" t-as="attachment" t-key="attachment.id">
                        <AttachmentCard attachment="attachment" onOpen.bind="this.onOpenAttachment"/>
                    </t>
                </div>
                <t t-if="turn.sources and turn.sources.length and !this.hideSources">
                    <div class="ayp_turn_sources">
                        <button
                            class="ayp_sources_chip"
                            type="button"
                            t-att-aria-label="turn.sources.length + ' sources'"
                            t-att-title="turn.sources.length + (turn.sources.length === 1 ? ' source' : ' sources')"
                            t-att-aria-expanded="this.isTurnSourcesExpanded(turn, turn_index)"
                            t-on-click="() => this.toggleTurnSources(turn, turn_index)"
                        >
                            <span class="ayp_sources_avatars d-inline-flex">
                                <t t-foreach="turn.sources.slice(0, 4)" t-as="src" t-key="src.id">
                                    <SourceIcon source="src"/>
                                </t>
                                <span
                                    t-if="turn.sources.length > 4"
                                    class="ayp_sources_more d-inline-flex align-items-center justify-content-center"
                                    t-esc="'+' + (turn.sources.length - 4)"
                                />
                            </span>
                            <i class="fa" t-att-class="this.isTurnSourcesExpanded(turn, turn_index) ? 'fa-caret-up' : 'fa-caret-down'"/>
                        </button>
                        <div
                            t-if="this.isTurnSourcesExpanded(turn, turn_index)"
                            class="ayp_turn_sources_list"
                        >
                            <SourceList
                                sources="turn.sources"
                                sessionId="this.session.state.sessionId"
                            />
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </t>

    <t t-name="aypatech_ai_assistant.ai_ChatMsgMeta">
        <div class="ayp_msg_meta" t-att-class="meta_side">
            <span class="ayp_msg_time" t-if="meta_at" t-esc="this.formatTimestamp(meta_at)"/>
            <div class="ayp_msg_actions">
                <button class="ayp_msg_btn ayp_msg_copy" type="button"
                        title="Copy message"
                        t-on-click="() => this.session.copyText(meta_text)">
                    <i class="fa fa-copy"/>
                </button>
                <button class="ayp_msg_btn ayp_msg_fork" type="button"
                        t-if="meta_event_id and !meta_in_history and this.session.canWrite()"
                        title="Branch — open a new session with the history up to this message"
                        t-on-click="() => this.session.runForkAtEvent(meta_event_id)">
                    <i class="fa fa-code-fork"/>
                </button>
                <button class="ayp_msg_btn ayp_msg_undo" type="button"
                        t-if="meta_event_id and !meta_in_history and this.session.canWrite()"
                        title="Rewind — remove this message and everything after"
                        t-on-click="() => this.session.runUndoToEvent(meta_event_id)">
                    <i class="fa fa-undo"/>
                </button>
                <button class="ayp_msg_btn ayp_msg_regenerate" type="button"
                        t-if="meta_can_regenerate"
                        title="Regenerate this answer"
                        t-on-click="() => this.session.onRegenerate()">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
        </div>
    </t>

    <t t-name="aypatech_ai_assistant.ai_AskCard">
        <t t-if="block.resolution === 'yesno'">
            <div class="ayp_ask_card">
                <div class="ayp_ask_head d-flex align-items-center">
                    <i class="fa fa-shield me-2"/>
                    <strong>Confirmation required</strong>
                    <span class="ms-2 text-muted small" t-if="block.preview and (block.preview.model_label or block.preview.model)" t-esc="'· ' + (block.preview.model_label or block.preview.model)"/>
                    <span class="ms-auto small" t-if="block.preview and block.preview.kind">
                        <button
                            class="btn btn-link btn-sm ayp_ask_toggle p-0"
                            t-att-title="this.askViewMode(block) === 'technical' ? 'Show friendly view' : 'Show technical view'"
                            t-on-click="() => this.toggleAskView(block.callId)"
                        >
                            <i class="fa" t-att-class="this.askViewMode(block) === 'technical' ? 'fa-list' : 'fa-code'"/>
                        </button>
                    </span>
                </div>
                <div class="ayp_ask_body">
                    <p class="mb-2 small" t-if="block.text" t-esc="block.text"/>
                    <t t-if="this.askViewMode(block) === 'human' and block.preview and block.preview.kind">
                        <t t-call="aypatech_ai_assistant.ai_AskPreview">
                            <t t-set="preview" t-value="block.preview"/>
                        </t>
                    </t>
                    <t t-elif="block.preview">
                        <pre class="ayp_ask_args small mb-2" t-esc="this.askArgsText(block)"/>
                    </t>
                </div>
                <t t-if="this.session.state.pendingAsk and this.session.state.pendingAsk.call_id === block.callId">
                    <div class="ayp_ask_resolved small text-muted" t-if="!this.session.canWrite()">Waiting for the owner to answer.</div>
                    <div class="ayp_ask_actions d-flex flex-wrap gap-2" t-else="">
                        <button class="btn btn-sm btn-primary" t-on-click="() => this.session.respondYesno('approve')">
                            <i class="fa fa-check me-1"/>Approve
                        </button>
                        <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.session.respondYesno('session')" title="Auto-approve matching calls for the rest of this conversation" t-if="this.session.state.pendingAsk.kind === 'approval'">
                            <i class="fa fa-star me-1"/>Allow for session
                        </button>
                        <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.session.respondYesno('reject')">
                            <i class="fa fa-times me-1"/>Reject
                        </button>
                    </div>
                </t>
                <t t-else="">
                    <div class="ayp_ask_resolved small text-muted">Resolved.</div>
                </t>
            </div>
        </t>
        <t t-else="">
            <div class="ayp_bubble ayp_bubble_assistant ayp_ask_simple">
                <strong class="d-block mb-1"><i class="fa fa-question-circle me-1"/>Question</strong>
                <span t-esc="block.text"/>
                <t t-if="block.preview and block.preview.kind">
                    <div class="mt-2">
                        <t t-call="aypatech_ai_assistant.ai_AskPreview">
                            <t t-set="preview" t-value="block.preview"/>
                        </t>
                    </div>
                </t>
                <div class="ayp_ask_options d-flex flex-wrap gap-2 mt-2" t-if="block.options and block.options.length">
                    <t t-foreach="block.options" t-as="opt" t-key="opt_index">
                        <button
                            class="btn btn-sm btn-outline-primary ayp_ask_option"
                            t-att-disabled="!this.session.canWrite() or this.session.state.status === 'running' or this.session.state.pendingAsk?.call_id !== block.callId"
                            t-on-click="() => this.session.answerWithOption(opt)"
                            t-esc="opt"
                        />
                    </t>
                </div>
                <t t-call="aypatech_ai_assistant.ai_ChatMsgMeta">
                    <t t-set="meta_at" t-value="block.at || turn.at"/>
                    <t t-set="meta_text" t-value="block.text"/>
                    <t t-set="meta_event_id" t-value="block.eventId || turn.eventId"/>
                    <t t-set="meta_side" t-value="''"/>
                    <t t-set="meta_in_history" t-value="turn.inHistory"/>
                </t>
            </div>
        </t>
    </t>

    <t t-name="aypatech_ai_assistant.ai_AskPreview">
        <div class="ayp_ask_preview">
            <div class="ayp_ask_title mb-2" t-esc="preview.title"/>
            <t t-if="preview.kind === 'update'">
                <div class="ayp_ask_targets small text-muted mb-2" t-if="preview.targets and preview.targets.length">
                    <i class="fa fa-angle-right me-1"/>
                    <t t-foreach="preview.targets" t-as="tgt" t-key="tgt_index">
                        <span class="ayp_ask_target" t-esc="tgt.display_name"/>
                        <span t-if="!tgt_last" class="text-muted">, </span>
                    </t>
                </div>
                <table class="ayp_ask_changes w-100">
                    <thead>
                        <tr>
                            <th>Field</th>
                            <th>From</th>
                            <th>To</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="preview.changes" t-as="change" t-key="change_index">
                            <tr>
                                <td><strong t-esc="change.label"/><br/><code class="text-muted" t-esc="change.field"/></td>
                                <td><span t-if="change.from" t-esc="change.from"/><span t-else="" class="ayp_ask_empty">—</span></td>
                                <td><span t-if="change.to" t-esc="change.to"/><span t-else="" class="ayp_ask_empty">—</span></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-elif="preview.kind === 'delete'">
                <ul class="ayp_ask_targets_list small mb-0">
                    <t t-foreach="preview.targets" t-as="tgt" t-key="tgt_index">
                        <li>
                            <i class="fa fa-trash-o text-danger me-1"/>
                            <span t-esc="tgt.display_name"/>
                            <code class="text-muted ms-1" t-esc="'#' + tgt.id"/>
                        </li>
                    </t>
                    <li t-if="!preview.targets or !preview.targets.length" class="ayp_ask_empty">No records resolved.</li>
                </ul>
            </t>
            <t t-elif="preview.kind === 'call'">
                <div class="ayp_ask_call mb-2">
                    <i class="fa fa-bolt me-1"/>
                    <code t-esc="preview.method"/>
                    <span class="text-muted"> on </span>
                    <span t-esc="preview.model_label or preview.model"/>
                </div>
                <ul class="ayp_ask_targets_list small mb-0" t-if="preview.targets and preview.targets.length">
                    <t t-foreach="preview.targets" t-as="tgt" t-key="tgt_index">
                        <li>
                            <span t-esc="tgt.display_name"/>
                            <code class="text-muted ms-1" t-esc="'#' + tgt.id"/>
                        </li>
                    </t>
                </ul>
            </t>
            <t t-elif="preview.kind === 'create'">
                <table class="ayp_ask_changes w-100">
                    <thead>
                        <tr>
                            <th>Field</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="preview.properties" t-as="prop" t-key="prop_index">
                            <tr>
                                <td><strong t-esc="prop.label"/><br/><code class="text-muted" t-esc="prop.field"/></td>
                                <td><span t-if="prop.value" t-esc="prop.value"/><span t-else="" class="ayp_ask_empty">—</span></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </div>
    </t>

</templates>
