<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.ai_PromptHistoryDialog">
        <Dialog title="this.title" size="'lg'">
            <div class="ayp_prompt_history">
                <div class="ayp_prompt_history_sidebar">
                    <div t-if="this.state.loading" class="text-muted small p-2">Loading…</div>
                    <div t-elif="!this.state.entries.length" class="text-muted small p-2">No history yet.</div>
                    <button t-foreach="this.state.entries" t-as="entry" t-key="entry.index"
                            type="button"
                            t-attf-class="ayp_prompt_history_item {{ this.state.selectedIndex === entry.index ? 'selected' : '' }}"
                            t-on-click="() => this.selectRevision(entry.index)">
                        <div class="ayp_prompt_history_item_date" t-out="this.formatDate(entry.create_date)"/>
                        <div class="ayp_prompt_history_item_user text-muted small" t-out="entry.create_user_name or ''"/>
                    </button>
                </div>
                <div class="ayp_prompt_history_body">
                    <pre class="ayp_prompt_history_pre">
                        <t t-foreach="this.state.diffLines" t-as="line" t-key="line_index">
                            <span t-attf-class="ayp_prompt_history_line ayp_prompt_history_{{ line.kind }}" t-out="line.text"/>
                            <br/>
                        </t>
                    </pre>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-att-disabled="this.state.selectedIndex === null"
                        t-on-click="this.onRestore">Restore This Version</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
