<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.ai_SessionEventsField">
        <div class="ayp_chat ayp_session_events">
            <t t-if="turns.length">
                <t t-foreach="turns" t-as="turn" t-key="turn_index">
                    <t t-call="aypatech_ai_assistant.ai_ChatTurn">
                        <t t-set="turn" t-value="turn"/>
                    </t>
                </t>
            </t>
            <t t-else="">
                <div class="ayp_session_events_empty text-muted">
                    <i class="fa fa-inbox me-2"/>No entries yet.
                </div>
            </t>
        </div>
    </t>

</templates>
