<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_assistant.schedule_ScheduleCountdownField">
        <span class="ayp_schedule_countdown" t-att-title="tooltip">
            <t t-if="isEmpty">
                <span class="text-muted">—</span>
            </t>
            <t t-elif="isPast">
                <span t-esc="absoluteText"/>
                <span class="ayp_schedule_countdown_due text-muted ms-1" t-esc="pastLabel"/>
            </t>
            <t t-else="">
                <span t-esc="countdownText"/>
            </t>
        </span>
    </t>

</templates>
