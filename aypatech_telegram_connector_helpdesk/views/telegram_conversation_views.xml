<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_conversation_form_helpdesk" model="ir.ui.view">
        <field name="name">telegram.conversation.form.helpdesk</field>
        <field name="model">telegram.conversation</field>
        <field name="inherit_id" ref="aypatech_telegram_connector.view_telegram_conversation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_assign_to_me']" position="after">
                <button name="action_create_ticket" type="object" string="Create Ticket"
                        groups="helpdesk.group_helpdesk_user" invisible="ticket_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_ticket" type="object" class="oe_stat_button" icon="fa-life-ring"
                        groups="helpdesk.group_helpdesk_user" invisible="not ticket_id">
                    <span class="o_stat_text">Ticket</span>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ticket_id" groups="helpdesk.group_helpdesk_user"/>
            </xpath>
        </field>
    </record>
</odoo>
