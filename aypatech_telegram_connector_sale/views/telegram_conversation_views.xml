<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_conversation_form_sale" model="ir.ui.view">
        <field name="name">telegram.conversation.form.sale</field>
        <field name="model">telegram.conversation</field>
        <field name="inherit_id" ref="aypatech_telegram_connector.view_telegram_conversation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_assign_to_me']" position="after">
                <button name="action_new_quotation" type="object" string="New Quotation"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_sale_orders" type="object" class="oe_stat_button" icon="fa-dollar"
                        groups="sales_team.group_sale_salesman" invisible="not sale_order_count">
                    <field name="sale_order_count" widget="statinfo" string="Orders"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
