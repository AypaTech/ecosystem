<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_aypatech_mail" model="ir.module.category">
            <field name="name">Aypatech Mail</field>
            <field name="sequence">20</field>
        </record>


        <record id="group_mail_user" model="res.groups">
            <field name="name">Mail User</field>
            <field name="category_id" ref="module_category_aypatech_mail"/>
            <field name="comment">Read/send own mailbox, reply/forward, use permitted folders.</field>
        </record>

        <record id="group_mail_manager" model="res.groups">
            <field name="name">Mail Manager</field>
            <field name="category_id" ref="module_category_aypatech_mail"/>
            <field name="implied_ids" eval="[(4, ref('group_mail_user'))]"/>
            <field name="comment">Manage shared mailboxes, members, templates/signatures.</field>
        </record>

        <record id="group_mail_administrator" model="res.groups">
            <field name="name">Mail Administrator</field>
            <field name="category_id" ref="module_category_aypatech_mail"/>
            <field name="implied_ids" eval="[(4, ref('group_mail_manager'))]"/>
            <field name="comment">Mailcow connection, domains, mailboxes, aliases, health.</field>
            <!-- without this nobody, not even the admin who installed it, can reach
                 the app right after install, so it vanishes from the app switcher -->
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- ==================================================================
             Record rules: a Mail User only ever sees mailboxes/messages/
             threads they own or that were explicitly shared with them
             (spec section 21: mailbox-view permission is separate from
             send-as permission - the send side is enforced in the compose
             flow, not here).
             ================================================================== -->

        <record id="rule_mail_account_personal" model="ir.rule">
            <field name="name">Mail Account: own or shared mailboxes only</field>
            <field name="model_id" ref="model_aypatech_mail_account"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('shared_user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_user'))]"/>
        </record>

        <record id="rule_mail_account_administrator" model="ir.rule">
            <field name="name">Mail Account: administrator sees all</field>
            <field name="model_id" ref="model_aypatech_mail_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_administrator'))]"/>
        </record>

        <record id="rule_mail_message_personal" model="ir.rule">
            <field name="name">Mail Message: own or shared mailboxes only</field>
            <field name="model_id" ref="model_aypatech_mail_message"/>
            <field name="domain_force">
                ['|', ('account_id.user_id', '=', user.id), ('account_id.shared_user_ids', 'in', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_mail_user'))]"/>
        </record>

        <record id="rule_mail_message_administrator" model="ir.rule">
            <field name="name">Mail Message: administrator sees all</field>
            <field name="model_id" ref="model_aypatech_mail_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_administrator'))]"/>
        </record>

        <record id="rule_mail_thread_personal" model="ir.rule">
            <field name="name">Mail Thread: own or shared mailboxes only</field>
            <field name="model_id" ref="model_aypatech_mail_thread"/>
            <field name="domain_force">
                ['|', ('account_id.user_id', '=', user.id), ('account_id.shared_user_ids', 'in', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_mail_user'))]"/>
        </record>

        <record id="rule_mail_thread_administrator" model="ir.rule">
            <field name="name">Mail Thread: administrator sees all</field>
            <field name="model_id" ref="model_aypatech_mail_thread"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_administrator'))]"/>
        </record>

        <record id="rule_mail_folder_personal" model="ir.rule">
            <field name="name">Mail Folder: own or shared mailboxes only</field>
            <field name="model_id" ref="model_aypatech_mail_folder"/>
            <field name="domain_force">
                ['|', ('account_id.user_id', '=', user.id), ('account_id.shared_user_ids', 'in', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_mail_user'))]"/>
        </record>

        <record id="rule_mail_folder_administrator" model="ir.rule">
            <field name="name">Mail Folder: administrator sees all</field>
            <field name="model_id" ref="model_aypatech_mail_folder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_administrator'))]"/>
        </record>

        <record id="rule_mail_label_personal" model="ir.rule">
            <field name="name">Mail Label: own or shared mailboxes only</field>
            <field name="model_id" ref="model_aypatech_mail_label"/>
            <field name="domain_force">
                ['|', ('account_id.user_id', '=', user.id), ('account_id.shared_user_ids', 'in', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_mail_user'))]"/>
        </record>

        <record id="rule_mail_label_administrator" model="ir.rule">
            <field name="name">Mail Label: administrator sees all</field>
            <field name="model_id" ref="model_aypatech_mail_label"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_administrator'))]"/>
        </record>

        <record id="rule_mail_tag_personal" model="ir.rule">
            <field name="name">Mail Tag: own or shared mailboxes only</field>
            <field name="model_id" ref="model_aypatech_mail_tag"/>
            <field name="domain_force">
                ['|', ('account_id.user_id', '=', user.id), ('account_id.shared_user_ids', 'in', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_mail_user'))]"/>
        </record>

        <record id="rule_mail_tag_administrator" model="ir.rule">
            <field name="name">Mail Tag: administrator sees all</field>
            <field name="model_id" ref="model_aypatech_mail_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_administrator'))]"/>
        </record>

    </data>
</odoo>
