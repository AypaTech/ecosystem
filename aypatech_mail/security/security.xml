<odoo>
    <data noupdate="1">

        <record id="module_category_aypatech_mail" model="ir.module.category">
            <field name="name">Aypatech Mail</field>
            <field name="sequence">20</field>
        </record>

        <record id="res_groups_privilege_aypatech_mail" model="res.groups.privilege">
            <field name="name">Aypatech Mail</field>
            <field name="category_id" ref="module_category_aypatech_mail"/>
        </record>

        <record id="group_mail_user" model="res.groups">
            <field name="name">Mail User</field>
            <field name="privilege_id" ref="res_groups_privilege_aypatech_mail"/>
            <field name="comment">Read/send own mailbox, reply/forward, use permitted folders.</field>
        </record>

        <record id="group_mail_manager" model="res.groups">
            <field name="name">Mail Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_aypatech_mail"/>
            <field name="implied_ids" eval="[(4, ref('group_mail_user'))]"/>
            <field name="comment">Manage shared mailboxes, members, templates/signatures.</field>
        </record>

        <record id="group_mail_administrator" model="res.groups">
            <field name="name">Mail Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_aypatech_mail"/>
            <field name="implied_ids" eval="[(4, ref('group_mail_manager'))]"/>
            <field name="comment">Mailcow connection, domains, mailboxes, aliases, health.</field>
