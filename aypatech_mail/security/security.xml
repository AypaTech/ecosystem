                 &#1576;&#1607; &#1575;&#1740;&#1606; &#1605;&#1575;&#1688;&#1608;&#1604; &#1583;&#1587;&#1578;&#1585;&#1587;&#1740; &#1606;&#1583;&#1575;&#1585;&#1583; &#1608; &#1705;&#1604; &#1575;&#1662; &#1575;&#1586; App Switcher &#1606;&#1575;&#1662;&#1583;&#1740;&#1583;
                 &#1605;&#1740;&#8204;&#1588;&#1608;&#1583;&#1548; &#1670;&#1608;&#1606; &#1607;&#1740;&#1670; &#1605;&#1606;&#1608;&#1740;&#1740; &#1586;&#1740;&#1585; &#1570;&#1606; &#1602;&#1575;&#1576;&#1604;&#8204;&#1583;&#1587;&#1578;&#1585;&#1587;&#1740; &#1606;&#1605;&#1740;&#8204;&#1605;&#1575;&#1606;&#1583;. -->
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
