<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mail_domain_list" model="ir.ui.view">
            <field name="name">aypatech.mail.domain.list</field>
            <field name="model">aypatech.mail.domain</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="server_id"/>
                    <field name="dns_verified" widget="boolean_toggle"/>
                    <field name="dkim_verified" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_mail_domain_form" model="ir.ui.view">
            <field name="name">aypatech.mail.domain.form</field>
            <field name="model">aypatech.mail.domain</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_create_in_mailcow" type="object" string="Create in Mailcow" class="btn-primary"
                                invisible="mailcow_id"/>
                        <button name="action_sync_from_mailcow" type="object" string="Refresh from Mailcow"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="server_id"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="mailcow_id" readonly="1"/>
                                <field name="dns_verified"/>
                                <field name="dkim_verified"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Mailboxes">
                                <field name="mailbox_ids" readonly="1">
                                    <list><field name="email"/><field name="user_id"/></list>
                                </field>
                            </page>
                            <page string="Aliases">
                                <field name="alias_ids">
                                    <list editable="bottom">
                                        <field name="alias"/>
                                        <field name="target"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mail_domain" model="ir.actions.act_window">
            <field name="name">Mail Domains</field>
            <field name="res_model">aypatech.mail.domain</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
