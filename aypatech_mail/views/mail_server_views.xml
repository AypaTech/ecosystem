<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mail_server_list" model="ir.ui.view">
            <field name="name">aypatech.mail.server.list</field>
            <field name="model">aypatech.mail.server</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="provider"/>
                    <field name="imap_host"/>
                    <field name="smtp_host"/>
                    <field name="account_count"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_mail_server_form" model="ir.ui.view">
            <field name="name">aypatech.mail.server.form</field>
            <field name="model">aypatech.mail.server</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_health_check" type="object" string="Test Mailcow Connection" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_accounts" type="object" class="oe_stat_button" icon="fa-envelope">
                                <field name="account_count" widget="statinfo" string="Accounts"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="provider"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="IMAP">
                                <group>
                                    <field name="imap_host"/>
                                    <field name="imap_port"/>
                                    <field name="imap_ssl"/>
                                </group>
                            </page>
                            <page string="SMTP">
                                <group>
                                    <field name="smtp_host"/>
                                    <field name="smtp_port"/>
                                    <field name="smtp_tls"/>
                                    <field name="smtp_ssl"/>
                                </group>
                            </page>
                            <page string="Mailcow API" invisible="provider != 'mailcow'">
                                <group>
                                    <field name="mailcow_api_url"/>
                                    <field name="mailcow_api_key" password="True" groups="aypatech_mail.group_mail_administrator"/>
                                    <field name="mailcow_api_key_display" readonly="1" groups="!aypatech_mail.group_mail_administrator"/>
                                </group>
                            </page>
                            <page string="Advanced">
                                <group>
                                    <field name="timeout"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mail_server" model="ir.actions.act_window">
            <field name="name">Mail Servers</field>
            <field name="res_model">aypatech.mail.server</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
