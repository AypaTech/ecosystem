<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mail_message_list" model="ir.ui.view">
            <field name="name">aypatech.mail.message.list</field>
            <field name="model">aypatech.mail.message</field>
            <field name="arch" type="xml">
                <list decoration-bf="not is_read">
                    <field name="is_starred" widget="boolean_favorite" nolabel="1"/>
                    <field name="email_from" string="From" invisible="direction == 'outgoing'"/>
                    <field name="email_to" string="To" invisible="direction == 'incoming'"/>
                    <field name="subject"/>
                    <field name="folder_id"/>
                    <field name="send_state" optional="hide"/>
                    <field name="attachment_count" optional="hide"/>
                    <field name="date"/>
                </list>
            </field>
        </record>

        <record id="view_mail_message_form" model="ir.ui.view">
            <field name="name">aypatech.mail.message.form</field>
            <field name="model">aypatech.mail.message</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="send_state" widget="statusbar" statusbar_visible="draft,queued,sending,sent"/>
                        <button name="action_send" type="object" string="Send" class="btn-primary"
                                invisible="send_state not in ('draft', 'queued', 'failed')"/>
                        <button name="action_reply" type="object" string="Reply"
                                invisible="direction != 'incoming' or not id"/>
                        <button name="action_reply_all" type="object" string="Reply All"
                                invisible="direction != 'incoming' or not id"/>
                        <button name="action_forward" type="object" string="Forward" invisible="not id"/>
                        <button name="action_mark_read" type="object" string="Mark Read"
                                invisible="is_read or direction != 'incoming'"/>
                        <button name="action_mark_unread" type="object" string="Mark Unread"
                                invisible="not is_read"/>
                        <button name="action_create_partner" type="object" string="Add to Contacts"
                                class="btn-secondary" invisible="partner_id"/>
                    </header>
                    <sheet>
                        <field name="partner_id" widget="many2one_avatar" invisible="not partner_id" readonly="1"/>
                        <group>
                            <group>
                                <field name="account_id"/>
                                <field name="email_from"/>
                                <field name="email_to"/>
                                <field name="email_cc"/>
                            </group>
                            <group>
                                <field name="subject"/>
                                <field name="is_starred" widget="boolean_favorite" nolabel="1"/>
                                <field name="date"/>
                                <field name="direction"/>
                                <field name="is_read"/>
                                <field name="label_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Body">
                                <field name="body_html" options="{'style-inline': true}"/>
                            </page>
                            <page string="Attachments">
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </page>
                            <page string="Linked Records">
                                <field name="linked_record_ids" readonly="1">
                                    <list>
                                        <field name="res_model"/>
                                        <field name="record_name"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Technical" groups="base.group_no_one">
                                <group>
                                    <field name="message_id"/>
                                    <field name="in_reply_to"/>
                                    <field name="references"/>
                                    <field name="uid"/>
                                    <field name="thread_id"/>
                                    <field name="send_attempts"/>
                                    <field name="last_send_error"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_mail_message_kanban" model="ir.ui.view">
            <field name="name">aypatech.mail.message.kanban</field>
            <field name="model">aypatech.mail.message</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="is_read"/>
                    <field name="is_starred"/>
                    <field name="direction"/>
                    <field name="partner_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex">
                                <img t-if="record.partner_id.raw_value" class="rounded-circle me-2"
                                     t-attf-src="/web/image/res.partner/#{record.partner_id.raw_value}/avatar_128"
                                     width="32" height="32"/>
                                <div t-else="1" class="rounded-circle bg-light text-muted d-flex align-items-center justify-content-center me-2"
                                     style="width:32px;height:32px;flex-shrink:0">
                                    <i class="fa fa-user"/>
                                </div>
                                <div t-attf-class="flex-grow-1 #{!record.is_read.raw_value ? 'fw-bold' : ''}">
                                    <div class="d-flex justify-content-between">
                                        <span t-out="record.direction.raw_value == 'incoming' ? record.email_from.value : record.email_to.value"/>
                                        <i t-attf-class="fa #{record.is_starred.raw_value ? 'fa-star text-warning' : 'fa-star-o text-muted'}"/>
                                    </div>
                                    <div t-out="record.subject.value"/>
                                    <div class="text-muted small" t-out="record.date.value"/>
                                    <field name="label_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_mail_message_search" model="ir.ui.view">
            <field name="name">aypatech.mail.message.search</field>
            <field name="model">aypatech.mail.message</field>
            <field name="arch" type="xml">
                <search>
                    <field name="subject"/>
                    <field name="email_from"/>
                    <field name="email_to"/>
                    <field name="body_text" string="Body"/>
                    <field name="account_id"/>
                    <field name="label_ids" string="Labels"/>
                    <field name="tag_ids" string="Tags"/>
                    <filter name="unread" string="Unread" domain="[('is_read', '=', False)]"/>
                    <filter name="starred" string="Starred" domain="[('is_starred', '=', True)]"/>
                    <filter name="has_attachment" string="Has Attachment" domain="[('attachment_ids', '!=', False)]"/>
                    <filter name="has_label" string="Has Labels" domain="[('label_ids', '!=', False)]"/>
                    <filter name="has_tag" string="Has Tags" domain="[('tag_ids', '!=', False)]"/>
                    <separator/>
                    <filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                    <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                    <group>
                        <filter name="group_by_folder" string="Folder" context="{'group_by': 'folder_id'}"/>
                        <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                        <filter name="group_by_thread" string="Conversation" context="{'group_by': 'thread_id'}"/>
                        <filter name="group_by_label" string="Label" context="{'group_by': 'label_ids'}"/>
                        <filter name="group_by_tag" string="Tag" context="{'group_by': 'tag_ids'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_mail_message_inbox" model="ir.actions.act_window">
            <field name="name">Inbox</field>
            <field name="res_model">aypatech.mail.message</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('folder_id.folder_type', '=', 'inbox')]</field>
            <field name="context">{'search_default_unread': 1}</field>
        </record>

        <record id="action_mail_message_sent" model="ir.actions.act_window">
            <field name="name">Sent</field>
            <field name="res_model">aypatech.mail.message</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('direction', '=', 'outgoing'), ('send_state', '=', 'sent')]</field>
        </record>

        <record id="action_mail_message_drafts" model="ir.actions.act_window">
            <field name="name">Drafts</field>
            <field name="res_model">aypatech.mail.message</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('direction', '=', 'outgoing'), ('send_state', 'in', ['draft', 'queued', 'failed'])]</field>
            <field name="context">{'default_direction': 'outgoing'}</field>
        </record>

        <record id="action_mail_message_starred" model="ir.actions.act_window">
            <field name="name">Starred</field>
            <field name="res_model">aypatech.mail.message</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('is_starred', '=', True)]</field>
        </record>

        <record id="action_mail_message_all" model="ir.actions.act_window">
            <field name="name">All Messages</field>
            <field name="res_model">aypatech.mail.message</field>
            <field name="view_mode">list,kanban,form</field>
        </record>

    </data>
</odoo>
