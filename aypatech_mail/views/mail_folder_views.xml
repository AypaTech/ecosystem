<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mail_folder_list" model="ir.ui.view">
            <field name="name">aypatech.mail.folder.list</field>
            <field name="model">aypatech.mail.folder</field>
            <field name="arch" type="xml">
                <list>
                    <field name="account_id"/>
                    <field name="name"/>
                    <field name="remote_name"/>
                    <field name="folder_type"/>
                    <field name="message_count"/>
                    <field name="unread_count"/>
                </list>
            </field>
        </record>

        <record id="action_mail_folder" model="ir.actions.act_window">
            <field name="name">Mail Folders</field>
            <field name="res_model">aypatech.mail.folder</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
