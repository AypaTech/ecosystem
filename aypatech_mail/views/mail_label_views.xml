<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mail_label_list" model="ir.ui.view">
            <field name="name">aypatech.mail.label.list</field>
            <field name="model">aypatech.mail.label</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="account_id"/>
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                    <field name="message_count"/>
                </list>
            </field>
        </record>

        <record id="action_mail_label" model="ir.actions.act_window">
            <field name="name">Mail Labels</field>
            <field name="res_model">aypatech.mail.label</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
