<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mail_account_list" model="ir.ui.view">
            <field name="name">aypatech.mail.account.list</field>
            <field name="model">aypatech.mail.account</field>
            <field name="arch" type="xml">
                <list>
                    <field name="email"/>
                    <field name="user_id"/>
                    <field name="server_id"/>
                    <field name="is_shared"/>
                    <field name="sync_enabled" widget="boolean_toggle"/>
                    <field name="last_full_sync"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_mail_account_form" model="ir.ui.view">
            <field name="name">aypatech.mail.account.form</field>
            <field name="model">aypatech.mail.account</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                        <button name="action_discover_folders" type="object" string="Discover Folders" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="email"/>
                                <field name="username" placeholder="defaults to email"/>
                                <field name="password" password="True" groups="aypatech_mail.group_mail_administrator"/>
                                <field name="server_id"/>
                                <field name="domain_id"/>
                            </group>
                            <group>
                                <field name="user_id"/>
                                <field name="shared_user_ids" widget="many2many_tags"/>
                                <field name="sync_enabled"/>
                                <field name="active"/>
                                <field name="last_full_sync" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Signature">
                                <field name="signature"/>
                            </page>
                            <page string="Folders">
                                <field name="folder_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="remote_name"/>
                                        <field name="folder_type"/>
                                        <field name="message_count"/>
                                        <field name="unread_count"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mail_account" model="ir.actions.act_window">
            <field name="name">Mail Accounts</field>
            <field name="res_model">aypatech.mail.account</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
