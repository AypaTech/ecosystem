<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_mail_tag_list" model="ir.ui.view">
            <field name="name">aypatech.mail.tag.list</field>
            <field name="model">aypatech.mail.tag</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="account_id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_mail_tag" model="ir.actions.act_window">
            <field name="name">Mail Tags</field>
            <field name="res_model">aypatech.mail.tag</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
