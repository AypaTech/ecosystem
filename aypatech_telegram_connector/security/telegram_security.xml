<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_telegram" model="res.groups.privilege">
        <field name="name">Telegram</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_telegram_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_telegram"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Reads and answers the Telegram conversations of their teams or assigned to them.</field>
    </record>

    <record id="group_telegram_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_telegram"/>
        <field name="implied_ids" eval="[Command.link(ref('group_telegram_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Manages bots, teams, routes, deliveries, logs and sees all conversations of their companies.</field>
    </record>
</odoo>
