<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_team_list" model="ir.ui.view">
        <field name="name">telegram.team.list</field>
        <field name="model">telegram.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="assignment_method"/>
                <field name="member_ids" widget="many2many_avatar_user"/>
                <field name="open_conversation_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_team_form" model="ir.ui.view">
        <field name="name">telegram.team.form</field>
        <field name="model">telegram.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Sales support"/></h1></div>
                    <group>
                        <group>
                            <field name="assignment_method" widget="radio"/>
                            <field name="last_assigned_user_id" invisible="assignment_method != 'round_robin'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="member_ids" widget="many2many_avatar_user"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">telegram.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
