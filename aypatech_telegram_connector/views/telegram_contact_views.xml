<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_contact_list" model="ir.ui.view">
        <field name="name">telegram.contact.list</field>
        <field name="model">telegram.contact</field>
        <field name="arch" type="xml">
            <list decoration-danger="blocked">
                <field name="name"/>
                <field name="username"/>
                <field name="partner_id"/>
                <field name="bot_id"/>
                <field name="language_code" optional="hide"/>
                <field name="blocked" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_contact_form" model="ir.ui.view">
        <field name="name">telegram.contact.form</field>
        <field name="model">telegram.contact</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_forget_identity" type="object" string="Forget Telegram identity"
                            groups="aypatech_telegram_connector.group_telegram_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_conversations" type="object" class="oe_stat_button" icon="forum">
                            <field name="conversation_count" widget="statinfo" string="Conversations"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="username" readonly="1"/>
                            <field name="first_name" readonly="1"/>
                            <field name="last_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="bot_id" readonly="1"/>
                            <field name="telegram_user_id" groups="aypatech_telegram_connector.group_telegram_manager"/>
                            <field name="language_code" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="blocked" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telegram_contact_search" model="ir.ui.view">
        <field name="name">telegram.contact.search</field>
        <field name="model">telegram.contact</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="username"/>
                <field name="partner_id"/>
                <field name="bot_id"/>
                <filter name="filter_blocked" string="Blocked the bot" domain="[('blocked', '=', True)]"/>
                <filter name="group_bot" string="Bot" context="{'group_by': 'bot_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_telegram_contact" model="ir.actions.act_window">
        <field name="name">Telegram Contacts</field>
        <field name="res_model">telegram.contact</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
