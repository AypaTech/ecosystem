<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_conversation_kanban" model="ir.ui.view">
        <field name="name">telegram.conversation.kanban</field>
        <field name="model">telegram.conversation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="0" group_create="0" group_delete="0" group_edit="0"
                    sample="1">
                <field name="is_blocked"/>
                <field name="failed_delivery_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold text-truncate"/>
                            <field name="priority" widget="priority"/>
                        </div>
                        <field name="bot_id" class="text-muted small"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <div class="small" t-if="record.is_blocked.raw_value">
                            <span class="badge text-bg-danger">Blocked the bot</span>
                        </div>
                        <div class="small text-danger" t-if="record.failed_delivery_count.raw_value">
                            <i class="fa fa-exclamation-triangle me-1"/><field name="failed_delivery_count"/> failed
                        </div>
                        <footer>
                            <field name="last_customer_message_date" widget="date" class="small text-muted"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_telegram_conversation_list" model="ir.ui.view">
        <field name="name">telegram.conversation.list</field>
        <field name="model">telegram.conversation</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-muted="state in ('resolved', 'closed')" decoration-bf="state == 'new'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="bot_id" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="last_customer_message_date"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'" decoration-success="state == 'open'"
                       decoration-warning="state in ('pending_customer', 'pending_internal')"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_conversation_form" model="ir.ui.view">
        <field name="name">telegram.conversation.form</field>
        <field name="model">telegram.conversation</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_open_chat" type="object" string="Open chat" class="btn-primary" icon="fa-telegram"/>
                    <button name="action_assign_to_me" type="object" string="Assign to me"
                            invisible="state in ('closed',)"/>
                    <button name="action_pending_customer" type="object" string="Waiting for customer"
                            invisible="state not in ('new', 'open', 'pending_internal')"/>
                    <button name="action_resolve" type="object" string="Resolve"
                            invisible="state in ('resolved', 'closed')"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state not in ('resolved', 'closed')"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,open,pending_customer,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_failed_deliveries" type="object" class="oe_stat_button"
                                icon="fa-exclamation-triangle" invisible="not failed_delivery_count">
                            <field name="failed_delivery_count" widget="statinfo" string="Failed"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_blocked">
                        The customer blocked the bot. Messages cannot be delivered until they write again.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contact_id" readonly="1"/>
                            <field name="bot_id" readonly="1"/>
                            <field name="channel_id" invisible="1"/>
                            <field name="chat_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="last_customer_message_date"/>
                            <field name="last_agent_message_date"/>
                        </group>
                        <group>
                            <field name="message_count"/>
                            <field name="is_blocked" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Telegram messages" name="messages">
                            <field name="telegram_message_ids" readonly="1">
                                <list create="0" decoration-danger="state == 'failed'">
                                    <field name="create_date"/>
                                    <field name="direction"/>
                                    <field name="message_kind"/>
                                    <field name="body_preview"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_telegram_conversation_search" model="ir.ui.view">
        <field name="name">telegram.conversation.search</field>
        <field name="model">telegram.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="bot_id"/>
                <field name="team_id"/>
                <field name="tag_ids"/>
                <filter name="filter_mine" string="My conversations" domain="[('user_id', '=', uid)]"/>
                <filter name="filter_unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'in', ('new', 'open', 'pending_customer', 'pending_internal'))]"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('state', 'in', ('pending_customer', 'pending_internal'))]"/>
                <filter name="filter_resolved" string="Resolved / closed" domain="[('state', 'in', ('resolved', 'closed'))]"/>
                <separator/>
                <filter name="filter_urgent" string="High priority" domain="[('priority', 'in', ('2', '3'))]"/>
                <group>
                    <filter name="group_bot" string="Bot" context="{'group_by': 'bot_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_user" string="Assignee" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_telegram_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">telegram.conversation</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="view_telegram_conversation_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Telegram conversation yet</p>
            <p>Conversations are created automatically when a customer writes to your bot.</p>
        </field>
    </record>
</odoo>
