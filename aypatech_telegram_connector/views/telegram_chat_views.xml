<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_chat_list" model="ir.ui.view">
        <field name="name">telegram.chat.list</field>
        <field name="model">telegram.chat</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="display_title"/>
                <field name="telegram_chat_id"/>
                <field name="chat_type"/>
                <field name="contact_id"/>
                <field name="bot_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_telegram_chat" model="ir.actions.act_window">
        <field name="name">Telegram Chats</field>
        <field name="res_model">telegram.chat</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
