<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_res_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.telegram</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_telegram_conversations" type="object" class="oe_stat_button"
                        icon="send" groups="aypatech_telegram_connector.group_telegram_user"
                        invisible="not telegram_conversation_count">
                    <field name="telegram_conversation_count" widget="statinfo" string="Telegram"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
