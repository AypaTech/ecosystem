<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_message_list" model="ir.ui.view">
        <field name="name">telegram.message.list</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="conversation_id"/>
                <field name="direction"/>
                <field name="message_kind"/>
                <field name="body_preview"/>
                <field name="telegram_message_id" optional="hide"/>
                <field name="bot_id" optional="hide"/>
                <field name="state" widget="badge" decoration-danger="state == 'failed'" decoration-success="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_message_form" model="ir.ui.view">
        <field name="name">telegram.message.form</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="conversation_id"/>
                            <field name="bot_id"/>
                            <field name="direction"/>
                            <field name="message_kind"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="telegram_message_id"/>
                            <field name="extra_telegram_message_ids"/>
                            <field name="update_id"/>
                            <field name="mail_message_id"/>
                        </group>
                    </group>
                    <field name="body_preview"/>
                    <field name="error_message" invisible="not error_message"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <field name="delivery_ids">
                        <list>
                            <field name="state"/>
                            <field name="attempt"/>
                            <field name="error_class"/>
                            <field name="error_message"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telegram_message_search" model="ir.ui.view">
        <field name="name">telegram.message.search</field>
        <field name="model">telegram.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="conversation_id"/>
                <field name="bot_id"/>
                <filter name="filter_inbound" string="Inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter name="filter_outbound" string="Outbound" domain="[('direction', '=', 'outbound')]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_telegram_message" model="ir.actions.act_window">
        <field name="name">Telegram Messages</field>
        <field name="res_model">telegram.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
