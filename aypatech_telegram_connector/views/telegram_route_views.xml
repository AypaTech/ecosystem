<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_route_list" model="ir.ui.view">
        <field name="name">telegram.route.list</field>
        <field name="model">telegram.route</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="bot_id"/>
                <field name="name"/>
                <field name="condition_type"/>
                <field name="condition_value" required="condition_type in ('keyword', 'language')"
                       invisible="condition_type not in ('keyword', 'language')"/>
                <field name="team_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_route_search" model="ir.ui.view">
        <field name="name">telegram.route.search</field>
        <field name="model">telegram.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="bot_id"/>
                <filter name="group_bot" string="Bot" context="{'group_by': 'bot_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_telegram_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">telegram.route</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Route new conversations automatically</p>
            <p>The first matching route (by sequence) decides the team, the assignee and tags. Otherwise the bot's default team is used.</p>
        </field>
    </record>
</odoo>
