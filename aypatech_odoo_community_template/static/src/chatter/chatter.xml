<?xml version="1.0" encoding="utf-8" ?>

<templates xml:space="preserve">

    <!-- Temporarily disabled for Odoo 20: this whole customization (custom
         External/Internal/Note buttons, notifications toggle, recipients
         list) was written against Odoo <=19's Chatter, which used plain
         `state`/`props`. Odoo 20 rewrote Chatter's reactivity (signal/proxy/
         propComputed from a new Owl2 API) and even dropped some props this
         relied on entirely (e.g. `compactHeight` no longer exists), so this
         needs a real rewrite against the new API, not a line-by-line xpath
         fix. Left empty so mail.Chatter renders as stock Odoo 20 until that
         rewrite happens. -->
    <t
        t-name="aypatech_odoo_community_template.Chatter"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
    </t>
</templates>
