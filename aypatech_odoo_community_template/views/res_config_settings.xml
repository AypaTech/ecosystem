<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
	    <field name="name">res.config.settings.form</field>
	    <field name="model">res.config.settings</field>
	    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
	    <field name="arch" type="xml">
	    	<xpath expr="//block[@id='user_default_rights']" position="before">
	    		<block title="Theme &amp; Branding" id="branding_settings">
	    			<setting string="Color Theme" help="Pick a full preset color scheme, or fine-tune colors manually below">
	    			    <div class="apt_theme_preset_gallery d-flex flex-wrap gap-3">
	    			        <button type="object" name="action_apply_color_theme" context="{'theme_key': 'odoo_classic'}" class="apt_theme_preset_card btn-link p-0">
	    			            <span class="apt_theme_preset_active_badge" invisible="active_theme_key != 'odoo_classic'"><i class="fa fa-check-circle"/></span>
	    			            <div class="apt_theme_preset_swatch">
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#243742;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#5D8DA8;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#28A745;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#FFAC00;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#DC3545;"/>
	    			            </div>
	    			            <span class="apt_theme_preset_label">Odoo Classic</span>
	    			        </button>
	    			        <button type="object" name="action_apply_color_theme" context="{'theme_key': 'ocean_blue'}" class="apt_theme_preset_card btn-link p-0">
	    			            <span class="apt_theme_preset_active_badge" invisible="active_theme_key != 'ocean_blue'"><i class="fa fa-check-circle"/></span>
	    			            <div class="apt_theme_preset_swatch">
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#0B3D5C;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#1E88C7;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#1FA37B;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#F2A93C;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#E24C4C;"/>
	    			            </div>
	    			            <span class="apt_theme_preset_label">Ocean Blue</span>
	    			        </button>
	    			        <button type="object" name="action_apply_color_theme" context="{'theme_key': 'forest_green'}" class="apt_theme_preset_card btn-link p-0">
	    			            <span class="apt_theme_preset_active_badge" invisible="active_theme_key != 'forest_green'"><i class="fa fa-check-circle"/></span>
	    			            <div class="apt_theme_preset_swatch">
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#1F3D2B;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#3E8E5C;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#4CAF50;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#D99A2B;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#C0392B;"/>
	    			            </div>
	    			            <span class="apt_theme_preset_label">Forest Green</span>
	    			        </button>
	    			        <button type="object" name="action_apply_color_theme" context="{'theme_key': 'sunset_orange'}" class="apt_theme_preset_card btn-link p-0">
	    			            <span class="apt_theme_preset_active_badge" invisible="active_theme_key != 'sunset_orange'"><i class="fa fa-check-circle"/></span>
	    			            <div class="apt_theme_preset_swatch">
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#4A2A1F;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#E0703A;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#4C9A6A;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#F2A33C;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#D9483A;"/>
	    			            </div>
	    			            <span class="apt_theme_preset_label">Sunset Orange</span>
	    			        </button>
	    			        <button type="object" name="action_apply_color_theme" context="{'theme_key': 'slate_gray'}" class="apt_theme_preset_card btn-link p-0">
	    			            <span class="apt_theme_preset_active_badge" invisible="active_theme_key != 'slate_gray'"><i class="fa fa-check-circle"/></span>
	    			            <div class="apt_theme_preset_swatch">
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#1E2328;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#5C6773;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#4C9A6A;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#D9A441;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#C0524A;"/>
	    			            </div>
	    			            <span class="apt_theme_preset_label">Slate Gray</span>
	    			        </button>
	    			        <button type="object" name="action_apply_color_theme" context="{'theme_key': 'royal_purple'}" class="apt_theme_preset_card btn-link p-0">
	    			            <span class="apt_theme_preset_active_badge" invisible="active_theme_key != 'royal_purple'"><i class="fa fa-check-circle"/></span>
	    			            <div class="apt_theme_preset_swatch">
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#2E1F45;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#7C4DBF;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#4C9A6A;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#D9A441;"/>
	    			                <span class="apt_theme_preset_swatch_dot" style="background-color:#C0524A;"/>
	    			            </div>
	    			            <span class="apt_theme_preset_label">Royal Purple</span>
	    			        </button>
	    			    </div>
	    			</setting>
	    			<setting string="Light Mode Colors" help="Customize the look and feel of the light mode">
                     	<div class="w-50 row">
                            <label for="color_brand_light" string="Brand" class="d-block w-75 py-2"/>
                            <field name="color_brand_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_primary_light" string="Primary" class="d-block w-75 py-2"/>
                            <field name="color_primary_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_info_light" string="Info" class="d-block w-75 py-2"/>
                            <field name="color_info_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_success_light" string="Success" class="d-block w-75 py-2"/>
                            <field name="color_success_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_warning_light" string="Warning" class="d-block w-75 py-2"/>
                            <field name="color_warning_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_danger_light" string="Danger" class="d-block w-75 py-2"/>
                            <field name="color_danger_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                        <button
                            name="action_reset_light_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Light Colors"
                            class="btn-link"
                        />
                    </setting>
	    			<setting string="Dark Mode Colors" help="Customize the look and feel of the dark mode">
                     	<div class="w-50 row">
                            <label for="color_brand_dark" string="Brand" class="d-block w-75 py-2"/>
                            <field name="color_brand_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_primary_dark" string="Primary" class="d-block w-75 py-2"/>
                            <field name="color_primary_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_info_dark" string="Info" class="d-block w-75 py-2"/>
                            <field name="color_info_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_success_dark" string="Success" class="d-block w-75 py-2"/>
                            <field name="color_success_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_warning_dark" string="Warning" class="d-block w-75 py-2"/>
                            <field name="color_warning_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_danger_dark" string="Danger" class="d-block w-75 py-2"/>
                            <field name="color_danger_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                        <button
                            name="action_reset_dark_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Dark Colors"
                            class="btn-link"
                        />
                    </setting>
	    			<setting string="AppsBar Colors" help="Customize the look and feel of the app sidebar">
             	        <div class="w-50 row">
                            <label for="theme_color_appsmenu_text_light" string="Apps Menu Text (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appsmenu_text_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appsmenu_text_dark" string="Apps Menu Text (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appsmenu_text_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_text_light" string="Text (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_text_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_active_light" string="Active (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_active_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_background_light" string="Background (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_background_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_text_dark" string="Text (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_text_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_active_dark" string="Active (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_active_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_background_dark" string="Background (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_background_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                        <button
                            name="action_reset_light_theme_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Light AppsBar Colors"
                            class="btn-link"
                        />
                        <button
                            name="action_reset_dark_theme_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Dark AppsBar Colors"
                            class="btn-link"
                        />
	    			</setting>
    			    <setting string="AppsBar Logo" company_dependent="1" help="Set your own logo for the app sidebar">
	    			    <div class="w-50 row">
                    	    <field name="appbar_image" widget="image" class="oe_avatar bg-transparent"/>
                        </div>
                    </setting>
                    <setting string="Favicon" company_dependent="1" help="Set your own browser tab favicon">
	    			    <div class="w-50 row">
                    	    <field name="theme_favicon" widget="image" class="oe_avatar bg-transparent"/>
                        </div>
                    </setting>
                    <setting
                        string="Apps Menu Background Image"
                        company_dependent="1"
                        help="Set the background image shown behind the full-screen apps menu"
                    >
                        <field name="theme_background_image" widget="image" class="ml-4 w-75 bg-transparent"/>
                    </setting>
	    		</block>
	    	</xpath>
	    </field>
	</record>

</odoo>
