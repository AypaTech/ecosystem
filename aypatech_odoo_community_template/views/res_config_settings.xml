<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
	    <field name="name">res.config.settings.form</field>
	    <field name="model">res.config.settings</field>
	    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
	    <field name="arch" type="xml">
	    	<xpath expr="//block[@id='user_default_rights']" position="before">
	    		<block title="Theme &amp; Branding" id="branding_settings">
	    			<setting string="Light Mode Colors" help="Customize the look and feel of the light mode">
                     	<div class="w-50 row">
                            <label for="color_brand_light" string="Brand" class="d-block w-75 py-2"/>
                            <field name="color_brand_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_primary_light" string="Primary" class="d-block w-75 py-2"/>
                            <field name="color_primary_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_info_light" string="Info" class="d-block w-75 py-2"/>
                            <field name="color_info_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_success_light" string="Success" class="d-block w-75 py-2"/>
                            <field name="color_success_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_warning_light" string="Warning" class="d-block w-75 py-2"/>
                            <field name="color_warning_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_danger_light" string="Danger" class="d-block w-75 py-2"/>
                            <field name="color_danger_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                        <button
                            name="action_reset_light_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Light Colors"
                            class="btn-link"
                        />
                    </setting>
	    			<setting string="Dark Mode Colors" help="Customize the look and feel of the dark mode">
                     	<div class="w-50 row">
                            <label for="color_brand_dark" string="Brand" class="d-block w-75 py-2"/>
                            <field name="color_brand_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_primary_dark" string="Primary" class="d-block w-75 py-2"/>
                            <field name="color_primary_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_info_dark" string="Info" class="d-block w-75 py-2"/>
                            <field name="color_info_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_success_dark" string="Success" class="d-block w-75 py-2"/>
                            <field name="color_success_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_warning_dark" string="Warning" class="d-block w-75 py-2"/>
                            <field name="color_warning_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_danger_dark" string="Danger" class="d-block w-75 py-2"/>
                            <field name="color_danger_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                        <button
                            name="action_reset_dark_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Dark Colors"
                            class="btn-link"
                        />
                    </setting>
	    			<setting string="AppsBar Colors" help="Customize the look and feel of the app sidebar">
             	        <div class="w-50 row">
                            <label for="theme_color_appsmenu_text_light" string="Apps Menu Text (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appsmenu_text_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appsmenu_text_dark" string="Apps Menu Text (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appsmenu_text_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_text_light" string="Text (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_text_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_active_light" string="Active (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_active_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_background_light" string="Background (Light)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_background_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_text_dark" string="Text (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_text_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_active_dark" string="Active (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_active_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
             	        <div class="w-50 row">
                            <label for="theme_color_appbar_background_dark" string="Background (Dark)" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_background_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                        <button
                            name="action_reset_light_theme_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Light AppsBar Colors"
                            class="btn-link"
                        />
                        <button
                            name="action_reset_dark_theme_color_assets"
                            icon="fa-refresh"
                            type="object"
                            string="Reset Dark AppsBar Colors"
                            class="btn-link"
                        />
	    			</setting>
    			    <setting string="AppsBar Logo" company_dependent="1" help="Set your own logo for the app sidebar">
	    			    <div class="w-50 row">
                    	    <field name="appbar_image" widget="image" class="oe_avatar bg-transparent"/>
                        </div>
                    </setting>
                    <setting string="Favicon" company_dependent="1" help="Set your own browser tab favicon">
	    			    <div class="w-50 row">
                    	    <field name="theme_favicon" widget="image" class="oe_avatar bg-transparent"/>
                        </div>
                    </setting>
                    <setting
                        string="Apps Menu Background Image"
                        company_dependent="1"
                        help="Set the background image shown behind the full-screen apps menu"
                    >
                        <field name="theme_background_image" widget="image" class="ml-4 w-75 bg-transparent"/>
                    </setting>
	    		</block>
	    	</xpath>
	    </field>
	</record>

</odoo>
