<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_dropshipping" model="ir.ui.view">
        <field name="name">product.template.form.dropshipping</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Dropshipping">
                    <group>
                        <field name="is_dropshipping_product"/>
                        <field name="dropshipping_source_url"/>
                        <field name="dropshipping_source_price"/>
                        <field name="dropshipping_source_currency"/>
                        <field name="dropshipping_import_job_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>