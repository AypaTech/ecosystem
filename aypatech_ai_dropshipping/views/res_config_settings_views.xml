<odoo>
    <record id="res_config_settings_view_form_ai_dropshipping" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.dropshipping</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <app data-string="AI Dropshipping" string="AI Dropshipping" name="ai_dropshipping_assistant">

                    <block title="AI API Activation">
                        <setting string="Enable AI API">
                            <field name="ai_dropshipping_ai_enabled"/>
                        </setting>
                    </block>

                    <block title="AI Provider Settings" invisible="not ai_dropshipping_ai_enabled">

                        <setting string="AI Provider">
                            <field name="ai_dropshipping_provider"/>
                        </setting>

                        <setting string="OpenAI Model" invisible="ai_dropshipping_provider != 'openai'">
                            <field name="ai_dropshipping_openai_model"/>
                        </setting>

                        <setting string="OpenAI API Key" invisible="ai_dropshipping_provider != 'openai'">
                            <field name="ai_dropshipping_openai_api_key" password="True"/>
                        </setting>

                        <setting string="Gemini Model" invisible="ai_dropshipping_provider != 'gemini'">
                            <field name="ai_dropshipping_gemini_model"/>
                        </setting>

                        <setting string="Gemini API Key" invisible="ai_dropshipping_provider != 'gemini'">
                            <field name="ai_dropshipping_gemini_api_key" password="True"/>
                        </setting>

                    </block>

                    <block title="Behavior Settings">

                        <setting string="Default Markup (%)">
                            <field name="ai_dropshipping_default_markup_percent"/>
                        </setting>

                        <setting string="Auto Confirm AI Content" invisible="not ai_dropshipping_ai_enabled">
                            <field name="ai_dropshipping_auto_confirm_ai_content"/>
                        </setting>

                        <setting string="Publish After Create">
                            <field name="ai_dropshipping_publish_after_create"/>
                        </setting>

                    </block>

                </app>
            </xpath>

        </field>
    </record>
</odoo>