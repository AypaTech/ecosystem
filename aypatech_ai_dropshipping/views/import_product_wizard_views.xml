<odoo>
    <record id="view_import_product_wizard" model="ir.ui.view">
        <field name="name">dropshipping.import.wizard.form</field>
        <field name="model">dropshipping.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Product">
                <group>
                    <field name="state" invisible="1"/>
                    <field name="url" readonly="state != 'input'"/>
                </group>

                <group string="Preview" invisible="state != 'preview'">
                    <field name="title"/>
                    <field name="description"/>
                    <field name="price"/>
                    <field name="currency"/>
                    <field name="target_language"/>
                    <field name="ai_result"/>
                </group>

                <footer>
                    <button string="Fetch"
                            type="object"
                            name="action_fetch"
                            class="btn-primary"
                            invisible="state != 'input'"/>

                    <button string="AI Rewrite"
                            type="object"
                            name="action_ai_rewrite"
                            class="btn-secondary"
                            invisible="state != 'preview'"/>

                    <button string="Create Product"
                            type="object"
                            name="action_confirm"
                            class="btn-success"
                            invisible="state != 'preview'"/>

                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>