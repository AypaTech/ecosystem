<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">aypatech.helpdesk.ticket.view.form</field>
        <field name="model">aypatech.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="alert alert-warning" role="alert" invisible="not awaiting_agent_since">
                        ⏳ Awaiting our reply since <field name="awaiting_agent_since" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not awaiting_customer_since">
                        Awaiting customer reply since <field name="awaiting_customer_since" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="number" readonly="1"/></h1>
                        <h2><field name="name"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="priority" widget="priority"/>
                            <field name="category_id"/>
                            <field name="urgency_score" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="partner_name"/>
                            <field name="partner_email"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Other Information" name="other_info">
                            <group>
                                <field name="last_stage_update" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ticket_view_list" model="ir.ui.view">
        <field name="name">aypatech.helpdesk.ticket.view.list</field>
        <field name="model">aypatech.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list decoration-warning="awaiting_agent_since">
                <field name="priority" widget="priority"/>
                <field name="number"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="stage_id"/>
                <field name="urgency_score" optional="show"/>
                <field name="awaiting_agent_since" column_invisible="1"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ticket_view_kanban" model="ir.ui.view">
        <field name="name">aypatech.helpdesk.ticket.view.kanban</field>
        <field name="model">aypatech.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="stage_id"/>
                <field name="urgency_score"/>
                <field name="awaiting_agent_since"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span t-if="record.urgency_score.raw_value"
                                  t-attf-class="badge {{ record.urgency_score.raw_value &gt;= 6 ? 'text-bg-danger' : (record.urgency_score.raw_value &gt;= 4 ? 'text-bg-warning' : 'text-bg-success') }}">
                                <i class="fa fa-bolt me-1"/><t t-out="record.urgency_score.raw_value"/>
                            </span>
                            <span t-if="record.awaiting_agent_since.raw_value" class="badge text-bg-danger">
                                <i class="fa fa-reply me-1"/>Awaiting our reply
                            </span>
                        </div>
                        <field name="name" class="fw-bold fs-5"/>
                        <div><field name="partner_id"/></div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <field name="priority" widget="priority"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">aypatech.helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
