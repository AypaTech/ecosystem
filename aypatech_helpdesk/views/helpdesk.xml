<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="helpdesk_form_inherit" model="ir.ui.view">
            <field name="name">helpdesk.helpdesk.form</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">

                        <page name="return" string="Return">
                            <group>
                                <group>
                                    <field name="sale_order_id" string="Ordine reso"/>
                                    <field name="sale_order_return_id" string="Cambio merce" readonly="1"/>
                                    <field name="shippypro_label_url" string="ShippyPRO label" readonly="1"
                                           widget="url"/>
                                </group>
                                <group>
                                    <button name="create_goods_change" string="Cambio Merce" type="object"
                                            invisible="sale_order_return_id"/>
                                </group>
                                <group colspan="2" groups="base.group_no_one">
                                    <field colspan="2" name="json_return"/>
                                </group>
                            </group>
                        </page>

                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="action_send_mail"
                            type="object"
                            string="Invia mail con etichetta"
                            invisible="not pickings_count"/>
                </xpath>
            </field>
        </record>

        <record id="rma_ticketing_view_stock_return_picking_form" model="ir.ui.view">
            <field name="name">rma_ticketing_view_stock_return_picking_form</field>
            <field name="model">stock.return.picking</field>
            <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_return_moves']" position="before">
                    <group>
                        <field name="return_without_carrier" string="Reso Senza Vettore" />
                        <field name="carrier_return_id" options="{'no_create': True,'no_create_edit': True}"/>
                    </group>
                    <field name="picking_return_id" invisible="1" />
                    <div class="o_row">
                        <button name="get_carrier_services" string="Scegli Servizio" type="object" class="btn btn-success" />
                        <field name="carrier_service_id" domain="['&amp;',('picking_id', '!=', False),('picking_id','=',picking_return_id)]" options="{'no_quick_create': True, 'no_create_edit' : True, 'no_open': True}"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="helpdesk_team_form_inherit" model="ir.ui.view">
            <field name="name">helpdesk.team.form.inherit</field>
            <field name="model">helpdesk.team</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='after-sales']" position="inside">
                    <div class="col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="change_goods_warehouse_id"/>
                            <div class="text-muted">
                                Magazzino dal quale partiranno le merci per il cambio
                            </div>
                            <div>
                                <field name="change_goods_warehouse_id"
                                       options="{'no_create': True,'no_create_edit': True}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="carrier_return_ita_id"/>
                            <div class="text-muted">
                                Corriere/servizio resi ITA
                            </div>
                            <div>
                                <field name="carrier_return_ita_id" options="{'no_create': True,'no_create_edit': True}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="carrier_return_eu_id"/>
                            <div class="text-muted">
                                Corriere/servizio resi EU
                            </div>
                            <div>
                                <field name="carrier_return_eu_id" options="{'no_create': True,'no_create_edit': True}"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>