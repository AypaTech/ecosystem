<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stage_view_list" model="ir.ui.view">
        <field name="name">aypatech.helpdesk.stage.view.list</field>
        <field name="model">aypatech.helpdesk.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="closed"/>
            </list>
        </field>
    </record>

    <record id="stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">aypatech.helpdesk.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="category_view_list" model="ir.ui.view">
        <field name="name">aypatech.helpdesk.category.view.list</field>
        <field name="model">aypatech.helpdesk.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">aypatech.helpdesk.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
