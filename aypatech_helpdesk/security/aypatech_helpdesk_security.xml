<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Helpdesk Agent</field>
    </record>
    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="ticket_rule_portal_own_only" model="ir.rule">
        <field name="name">Portal users: only their own tickets</field>
        <field name="model_id" ref="model_aypatech_helpdesk_ticket"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
