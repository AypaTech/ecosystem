<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_sequence_ticket" model="ir.sequence">
            <field name="name">Aypatech Helpdesk Ticket</field>
            <field name="code">aypatech.helpdesk.ticket</field>
            <field name="prefix">HT</field>
            <field name="padding">5</field>
        </record>

        <record id="stage_new" model="aypatech.helpdesk.stage">
            <field name="name">New</field>
            <field name="sequence">10</field>
        </record>
        <record id="stage_in_progress" model="aypatech.helpdesk.stage">
            <field name="name">In Progress</field>
            <field name="sequence">20</field>
        </record>
        <record id="stage_awaiting" model="aypatech.helpdesk.stage">
            <field name="name">Awaiting</field>
            <field name="sequence">30</field>
        </record>
        <record id="stage_done" model="aypatech.helpdesk.stage">
            <field name="name">Done</field>
            <field name="sequence">40</field>
            <field name="fold">True</field>
            <field name="closed">True</field>
        </record>
        <record id="stage_cancelled" model="aypatech.helpdesk.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">50</field>
            <field name="fold">True</field>
            <field name="closed">True</field>
        </record>

        <record id="team_support" model="aypatech.helpdesk.team">
            <field name="name">Support</field>
        </record>
    </data>
</odoo>
